{% set title='Passwort vergessen?' %}

{% extends 'layout/external.html.twig' %}

{% block content %}
    {{ form_start(form) }}
        <p>Hier kannst du ein neues Passwort für deinen Account in der {{ roundName }} per E-Mail anfordern, wenn du
            deines vergessen hast:</p>
        <p>Wenn du weitere Hilfe benötigst, kannst du <a href="{{ path('external.contact') }}">hier</a> einen
            Game-Admin
            kontaktieren.</p>
        <p>
            <label for="user_nick">Benutzername</label>
            {{ form_widget(form.nick,{id:'user_nick'}) }}
        </p>
        <p>
            <label for="user_email_fix">Deine E-Mail</label>
            {{ form_widget(form.email,{id:'user_email_fix'}) }}
        </p>
        <p class="form-buttons">
            {{ form_widget(form.submit) }}&nbsp;
            <a href="{{ path('external.login') }}">Zurück zum Login</a>
        </p>
    {{ form_end(form) }}
{% endblock %}

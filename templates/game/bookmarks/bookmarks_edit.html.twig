{% extends 'game/bookmarks/bookmarks.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block bookmarks %}
    {% if msg.success is defined %}
        {{ macros.successMessage(msg.success) }}
    {% endif %}

    {% if msg.error is defined %}
        {{ macros.errorMessage(msg.error) }}
    {% endif %}
    {{ form_start(form) }}
    <twig:Table title="Favorit bearbeiten">
        {% block table_content %}
            <tr>
                <th width="25%">Koordinaten</th>
                <td>
                    {% if bookmark.entity %}
                        {{ bookmark.entity.toString }}
                        {% if bookmark.entity.displayName %}({{ bookmark.entity.displayName }}){% endif %}
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Kommentar</th>
                <td>
                    {{ form_widget(form.comment) }}
                    {{ form_errors(form.comment) }}
                </td>
            </tr>
        {% endblock %}
    </twig:Table>
    {{ form_widget(form.save) }}&nbsp;
    <input type="button" value="Zurück" onclick="document.location='{{ path('game.bookmarks.target') }}'"/>
    {{ form_end(form) }}
{% endblock %}
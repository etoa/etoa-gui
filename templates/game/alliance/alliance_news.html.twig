{% extends 'game/alliance/alliance.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block alliance %}
    <h2>Allianznews</h2>

    {% if msg.success is defined %}
        {{ macros.successMessage(msg.success) }}
    {% endif %}

    {% if preview %}
        {{ macros.message("Vorschau - "~form.title.vars.value,BBCodeToHTML(form.text.vars.value)|raw) }}
    {% endif %}
    {{ form_start(form) }}
        <twig:Table title="Neue Allianznews">
            {% block table_content %}
            <tr>
                <th colspan="3">
                    Sende diese Nachricht nur ab, wenn du dir bezüglich der Rathausregeln sicher bist! Eine Missachtung kann zur Sperrung des Accounts führen!
                </th>
            </tr>
            <tr>
                <th>Betreff:</th>
                <td colspan="2">
                    {{ form_widget(form.title) }}
                </td>
            </tr>
            <tr>
                <th>Text:</th>
                <td colspan="2">
                    {{ form_widget(form.text) }}
                    <br/>helpLink('textformat', 'Hilfe zur Formatierung')
                </td>
            </tr>
            <tr>
                <th>Ziel:</th>
                <td colspan=2>
                    {{ form_widget(form.target) }}
                </td>
            </tr>
            {% endblock %}
        </twig:Table>
        {{ form_widget(form._token) }}
        {% if preview %}
            {{ form_widget(form.send) }}
        {% endif %}
        {{ form_widget(form.preview) }}
        <a href="{{ path('game.alliance.overview') }}">
            <input type="button" value="Zurück" />
        </a>
    {{ form_end(form,{render_rest: false}) }}
{% endblock %}
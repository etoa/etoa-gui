{% extends 'game/alliance/alliance.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block alliance %}
    {% if alliances %}
        <twig:Table title="Übersicht">
        {% block table_content %}
            <tr>
                <th colspan="2">Allianz</th>
                <th>Status</th>
                <th>Start</th>
                <th>Ende / Name</th>
                <th>Aktionen</th>
            </tr>
            {% for alliance in alliances %}
                {% if alliance is not same as app.user.data.alliance %}
                    <tr>
                        <td>
                            <a href="{{ path('game.alliance.info',{'id':alliance.id}) }}">
                                [{{ alliance.tag }}]
                            </a>
                        </td>
                        <td>
                            {{ BBCodeToHTML(alliance.name) }}
                        </td>
                        {% if relations[alliance.id] is defined %}
                            {% if relations[alliance.id].level == constant('EtoA\\Alliance\\AllianceDiplomacyLevel::BND_CONFIRMED') %}
                                <td style="color:#0f0;">Bündnis</td>
                                <td>{{ formatTimestamp(relations[alliance.id].date) }}</td>
                                <td>{{ relations[alliance.id].name }}</td>
                            {% elseif relations[alliance.id].level == constant('EtoA\\Alliance\\AllianceDiplomacyLevel::WAR') %}
                                <td style="color:#f00;">Krieg</td>
                                <td>{{ formatTimestamp(relations[alliance.id].date) }}</td>
                                <td>{{ formatTimestamp(relations[alliance.id].date + 3600 *
                                        configValue('alliance_war_time')) }}</td>
                            {% elseif relations[alliance.id].level == constant('EtoA\\Alliance\\AllianceDiplomacyLevel::PEACE') %}
                                <td style="color:#3f9;">Frieden</td>
                                <td>{{ formatTimestamp(relations[alliance.id].date) }}</td>
                                <td>{{ formatTimestamp(relations[alliance.id].date + 3600 *
                                    param1('alliance_war_time')) }}</td>
                            {% elseif relations[alliance.id].level == constant('EtoA\\Alliance\\AllianceDiplomacyLevel::BND_REQUEST') %}
                                {% if relations[alliance.id].alliance2 == alliance %}
                                    <td style="color:#ff0;">Anfrage</td>
                                {% else %}
                                    <td style="color:#f90;">Anfrage an uns</td>
                                {% endif %}
                                <td>{{ formatTimestamp(relations[alliance.id].date) }}</td>
                                <td>-</td>
                            {% else %}
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                            {% endif %}
                        {% else %}
                            <td>-</td>
                            <td>-</td>
                            <td>-</td>
                        {% endif %}
                        <td>
                            {% if relations[alliance.id] is defined %}
                                {% if relations[alliance.id].level == constant('EtoA\\Alliance\\AllianceDiplomacyLevel::BND_CONFIRMED') %}
                                    <a href="{{ path('game.alliance.diplomacy.view',{'id':relations[alliance.id].id}) }}">Details</a> &nbsp;
                                    <a href="{{ path('game.alliance.diplomacy.end_bnd',{id:alliance.id}) }}">Auflösen</a>
                                {% elseif relations[alliance.id].level == constant('EtoA\\Alliance\\AllianceDiplomacyLevel::WAR') %}
                                    <a href="{{ path('game.alliance.diplomacy.view',{'id':relations[alliance.id].id}) }}">Kriegserklärung</a>
                                {% elseif relations[alliance.id].level == constant('EtoA\\Alliance\\AllianceDiplomacyLevel::PEACE') %}
                                    -
                                {% elseif relations[alliance.id].level == constant('EtoA\\Alliance\\AllianceDiplomacyLevel::BND_REQUEST') %}
                                    {% if relations[alliance.id].alliance2 == alliance %}
                                        <a href="{{ path('game.alliance.diplomacy.view',{'id':relations[alliance.id].id}) }}">Anschauen / Löschen</a>
                                    {% else %}
                                        <a href="{{ path('game.alliance.diplomacy.view',{'id':relations[alliance.id].id}) }}">Beantworten</a>
                                    {% endif %}
                                {% else %}
                                    {% if alliance.acceptBnd %}
                                        <a href="{{ path('game.alliance.diplomacy.begin_bnd',{id:alliance.id}) }}">Bündnis</a> &nbsp;
                                    {% endif %}
                                    <a href="{{ path('game.alliance.diplomacy.begin_war',{id:alliance.id}) }}">Krieg</a>
                                {% endif %}
                            {% else %}
                                {% if alliance.acceptBnd %}
                                    <a href="{{ path('game.alliance.diplomacy.begin_bnd',{id:alliance.id}) }}">Bündnis</a> &nbsp;
                                {% endif %}
                                <a href="{{ path('game.alliance.diplomacy.begin_war',{id:alliance.id}) }}">Krieg</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        {% endblock %}
        </twig:Table>
    {% else %}
        {{ macros.errorMessage('Es gibt noch keine Allianzen, welcher du den Krieg erklären kannst.') }}
    {% endif %}
    <a href="{{ path('game.alliance.overview') }}">
        <input type="button" value="Zurück zur Hauptseite"/>
    </a>
{% endblock %}
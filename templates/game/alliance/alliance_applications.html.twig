{% extends 'game/alliance/alliance.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block alliance %}
    {% if applications %}
        <h2>Bewerbungen</h2>
        {% if msg.error is defined %}
            {% for error in msg.error %}
                {{ macros.errorMessage(error.message) }}
            {% endfor %}
        {% endif %}
        {% if msg.success is defined %}
            {% for success in msg.success %}
                {{ macros.successMessage(success.message) }}
            {% endfor %}
        {% endif %}

        <form name="form" method="post">
            <twig:Table title="Bewerbungen prüfen">
                {% block table_content %}
                    <tr>
                        <th>User</th>
                        <th>Datum / Text</th>
                        <th>Nachricht</th>
                        <th>Aktion</th>
                    </tr>
                    {% if form.applications is defined %}
                        {% for application in form.applications %}
                            <tr>
                                <td {{ tm("Info", "Rang: " ~ application.vars.data.user.rank  ~ "<br>Punkte: " ~ formatNumber(application.vars.data.user.points) ~ "<br>Registriert: " ~ formatTimestamp(application.vars.data.user.registered))|raw }}>
                                    <a href="{{ path('game.userinfo',{id:application.vars.data.user.id}) }}"> {{ application.vars.data.user.nick }}</a>
                                </td>
                                <td>{{ formatTimestamp(application.vars.data.timestamp) }}<br/><br/>{{ BBCodeToHTML(application.vars.data.text) }}</td>
                                <td>{{ form_widget(application.answer) }} <br/><a href="{{ path('game.help.textformat') }}">Hilfe zur Formatierung</a></td>
                                <td>
                                    {% if allowAccept %}
                                        {{ form_widget(application.action.children.0) }}<span {{ tm("Anfrage annehmen",
                                        application.vars.data.user.nick ~ " wird in die Allianz aufgenommen.<br>Eine Nachricht wird
                                        versendet.")|raw }}> Annehmen</span><br><br>
                                    {% endif %}
                                    {{ form_widget(application.action.children.1) }}<span {{ tm("Anfrage ablehnen",
                                    application.vars.data.user.nick ~ " wird der Zutritt zu der Allianz verweigert.<br>Eine Nachricht
                                    wird versendet.")|raw }}> Ablehnen</span><br><br>
                                    {{ form_widget(application.action.children.2) }}<span {{ tm("Anfrage nicht bearbeiten",
                                    "Sofern vorhanden, wird eine Nachricht an " ~ application.vars.data.user.nick ~ " geschickt.")|raw }}> Nicht bearbeiten</span>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                {% endblock %}
                <tr id="memberCosts" style="display: none;"><td colspan="4" id="memberCostsTD"></td></tr>
            </twig:Table>
            {{ form_widget(form.save) }}
            {{ form_widget(form._token) }}
            <a href="{{ path('game.alliance.overview') }}">
                <input type="button" value="Zurück" />
            </a>
        </form>
    {% else %}
        {{ macros.errorMessage('Keine Bewerbungen vorhanden!') }}
        <a href="{{ path('game.alliance.overview') }}">
            <input type="button" value="Zurück" />
        </a>
    {% endif %}
{% endblock %}
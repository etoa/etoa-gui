{% extends app.request.query.get('popup')
    ? 'layout/base.html.twig'
    : 'layout/game.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% set currentContent %}
    {% if infoAlliance %}
        <twig:Table title="{{ infoAlliance.toString }}">
            {% block table_content %}
                {% if infoAlliance.getImageUrl %}
                    <tr>
                        <td colspan="3" style="text-align:center;background:#000">
                            <img src="{{ infoAlliance.getImageUrl }}" alt="Allianz-Logo"/>
                        </td>
                    </tr>
                {% endif %}

                {% if configValue('allow_wings') and infoAlliance.mother %}
                    <tr>
                        <th colspan="2" style="text-align:center;">
                            Diese Allianz ist ein Wing von
                            <b>
                                <a href={{ path('game.alliance.info',{id:infoAlliance.mother.id}) }}>{{ infoAlliance.mother.toString }}</a>
                            </b>
                        </th>
                    </tr>
                {% endif %}

                {% if infoAlliance.text %}
                    <tr>
                        <td colspan="2" style="text-align:center;">
                            {{ BBCodeToHTML(infoAlliance.text) }}
                        </td>
                    </tr>"
                {% endif %}

                {# Kriege #}
                {% if wars %}
                    <tr>
                        <th>Kriege:</th>
                        <td>
                            <table class="tbl">
                                <tr>
                                    <th>Allianz</th>
                                    <th>Punkte</th>
                                    <th>Zeitraum</th>
                                </tr>
                                {% for diplomacy in wars %}
                                    {% set opAlliance = allianceRepository.getAlliance(diplomacy.alliance1 == app.user.data.alliance ? diplomacy.alliance1.id : diplomacy.alliance2.id) %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('game.alliance.info',{id:opAlliance.id}) }}">{{ opAlliance.toString }}</a>
                                        </td>
                                        <td>{{ opAlliance.points }} /
                                            {{ opAlliance.averagePoints }}
                                        </td>
                                        <td>{{ formatTimestamp(diplomacy.date, false) }} bis
                                            {{ formatTimestamp(diplomacy.date + 3600 * configValue('alliance_war_time'), false) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </td>
                    </tr>
                {% endif %}

                {# Friedensabkommen #}
                {% if peace %}
                    <tr>
                        <th>Friedensabkommen:</th>
                        <td>
                            <table class="tbl">
                                <tr>
                                    <th>Allianz</th>
                                    <th>Punkte</th>
                                    <th>Zeitraum</th>
                                </tr>
                                {% for diplomacy in peace %}
                                    {% set opAlliance = allianceRepository.getAlliance(diplomacy.alliance1 == app.user.data.alliance ? diplomacy.alliance1.id : diplomacy.alliance2.id) %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('game.alliance.info',{id:opAlliance.id}) }}">{{ opAlliance.toString }}</a>
                                        </td>
                                        <td>{{ opAlliance.points }} /
                                            {{ opAlliance.averagePoints }}
                                        </td>
                                        <td>{{ formatTimestamp(diplomacy.date, false) }} bis
                                            {{ formatTimestamp(diplomacy.date + 3600 * param1('alliance_war_time'), false) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </td>
                    </tr>
                {% endif %}

                {# Bündnisse #}
                {% if bnds %}
                    <tr>
                        <th>Bündnisse:</th>
                        <td>
                            <table class="tbl">
                                <tr>
                                    <th>Bündnisname</th>
                                    <th>Allianz</th>
                                    <th>Punkte</th>
                                    <th>Seit</th>
                                </tr>
                                {% for diplomacy in bnds %}
                                    {% set opAlliance = allianceRepository.getAlliance(diplomacy.alliance1 == app.user.data.alliance ? diplomacy.alliance1.id : diplomacy.alliance2.id) %}
                                    <tr>
                                        <td>{{ diplomacy.name }}</td>
                                        <td>
                                            <a href="{{ path('game.alliance.info',{id:opAlliance.id}) }}">{{ opAlliance.toString }}</a>
                                        </td>
                                        <td>{{ formatNumber(opAlliance.points) }} /
                                            {{ formatNumber(opAlliance.averagePoints) }}
                                        </td>
                                        <td>{{ formatTimestamp(diplomacy.date) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </td>
                    </tr>
                {% endif %}

                {# Mitglieder #}
                <tr>
                    <th style="width:250px;">Mitglieder:</th>
                    <td id="members">
                        {{ infoAlliance.memberCount }}
                        {% if infoAlliance.publicMemberList %}
                            {{ component('AllianceMembers', {allianceId:infoAlliance.id}) }}
                        {% endif %}
                    </td>
                </tr>

                {# Punkte #}
                <tr>
                    <th>Punkte / Durchschnitt:</th>
                    <td>
                        {{ infoAlliance.points }} /
                        {{ infoAlliance.averagePoints }}
                    </td>
                </tr>

                {# Gründer #}
                <tr>
                    <th>Gründer:</th>
                    <td>
                        <a href="?page=userinfo&amp;id="
                           {{ infoAlliance.founder.id }}>{{ infoAlliance.founder.nick }}</a>
                    </td>
                </tr>

                {# Gründung #}
                <tr>
                    <th>Gründungsdatum:</th>
                    <td>
                        {{ formatTimestamp(infoAlliance.foundationTimestamp) }} (vor
                        {{ formatTimespan(date().timestamp - infoAlliance.foundationTimestamp) }})
                    </td>
                </tr>

                {# URL #}
                {% if infoAlliance.url %}
                    <tr>
                        <th>Website/Forum:</th>
                        <td><b>infoAlliance.url</b></td>
                    </tr>
                {% endif %}

                {# Diverses #}
                <tr>
                    <th>Akzeptiert Bewerbungen:</th>
                    <td>
                        {{ infoAlliance.acceptApplications ? "Ja" : "Nein" }}
                    </td>
                </tr>
                <tr>
                    <th>Akzeptiert Bündnisanfragen:</th>
                    <td>
                        {{ infoAlliance.acceptBnd ? "Ja" : "Nein" }}
                    </td>
                </tr>
            {% endblock %}
        </twig:Table>
    {% else %}
        {{ macros.errorMessage('Diese Allianz existiert nicht!') }}
    {% endif %}
    <br/><br/><input type="button" onclick="history.back();" value="Zurück" />
{% endset %}

{% if app.request.query.get('popup') %}
    {% set bodyTopStuff %}
        {{ currentContent }}
    {% endset %}
{% else %}
    {% set content %}
        {{ currentContent }}
    {% endset %}
{% endif %}
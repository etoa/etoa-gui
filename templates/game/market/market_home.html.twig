{% extends 'game/market/market.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block market %}
    {% if possible %}
        <twig:SellRess/>
        <twig:SellShip/>
        <twig:Auction/>
    {% else %}
        {{ macros.errorMessage('Auf diesem Planeten können keine weiteren Angebote erstellt werden!') }}
    {% endif %}
{% endblock %}
{% extends 'layout/game.html.twig' %}
{% block content %}
    <h1>Marktplatz (Stufe ' . $market->currentLevel . ') des Planeten ' . $planet->name . '</h1>
    <twig:ResourceBox/>
    {% set tabs = {
        "game.market.home" : "Angebote aufgeben",
        "game.market.sell" : "Eigene Angebote",
        "game.market.search" : "Angebotssuche",
    } %}

    <twig:MarketInfo/>
    <twig:tabmenu data="{{ tabs }}" active="{{ app.request.attributes.get('_route') }}"/><br>

    {% block market %}
    {% endblock %}
{% endblock %}
{% extends 'game/market/market.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block market %}
    {% if formRess.offers.vars.data %}
        {{ form_start(formRess) }}
        <twig:Table title="Rohstoffe">
            {% block table_content %}
                <tr>
                    <th>Rohstoffe:</th>
                    <th>Angebot:</th>
                    <th>Preis:</th>
                    <th>Marktplatz:</th>
                    <th>Datum/Text:</th>
                    <th>Zurückziehen:</th>
                </tr>
                {% for offer in formRess.offers %}
                    {% for rk,rn in constant('EtoA\\Universe\\Resources\\ResourceNames::NAMES') %}
                        <tr>
                            <td class="rescolor{{ rk }}"> {{ constant('EtoA\\Universe\\Resources\\ResIcons::ICONS')[rk]|raw }}  <b> {{ rn }} </b>:</td>
                            <td class="rescolor{{ rk }}"> {{ (offer.vars.data.sellResources.get(rk) > 0 ?
                            formatNumber(offer.vars.data.sellResources.get(rk)) : '-') }} </td>
                            <td class="rescolor{{ rk }}"> {{ (offer.vars.data.buyResources.get(rk) > 0 ?
                            formatNumber(offer.vars.data.buyResources.get(rk)) : '-') }} </td>
                            {% if loop.first %}
                                <td rowspan="5">{{ offer.vars.data.entity.entity.toString }} {{ offer.vars.data.entity.name }}</td>
                                <td rowspan="5"> {{ offer.vars.data.date|date("d.m.Y  G:i:s") }}<br/><br/>
                                    {{ offer.vars.data.text }}
                                </td>
                                <td rowspan="5" {{tm('','Wenn du das Angebot zurückziehst erhälst du '~(returnFactor * 100)~
                                '% des Angebotes zurück (abgerundet)')|raw}}>
                                    {{form_widget(offer.checkbox)}}
                                    <br/><br/>
                                    {% if offer.vars.data.forUser %}
                                        <span class="userAllianceMemberColor">Für Spieler {{ offer.vars.data.forUser }} reserviert</span>
                                    {% elseif offer.vars.data.forAlliance %}
                                        <span class="userAllianceMemberColor">Für Allianzmitglied Reserviert</span>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                    {% if not loop.last %}
                        <tr><td colspan="7" style="height:10px;background:#000"></td></tr>
                    {% endif %}
                {% endfor %}
            {% endblock %}
        </twig:Table>
        {{ form_widget(formRess.submit) }}
        {{ form_widget(formRess.checker) }}
        {{ form_end(formRess) }}<br/><br/>
    {% else %}
        {{ macros.message('Rohstoffe','Keine Angebote vorhanden!') }}
    {% endif %}

    {% if formShip.offers.vars.data %}
        {{ form_start(formShip) }}
        <twig:Table title="Rohstoffe">
            {% block table_content %}
                <tr>
                    <th>Angebot:</th>
                    <th colspan="2">Preis:</th>
                    <th>Datum/Text:</th>
                    <th>Zurückziehen:</th>
                </tr>
                {% for offer in formShip.offers %}
                    {% for rk,rn in constant('EtoA\\Universe\\Resources\\ResourceNames::NAMES') %}
                        <tr>
                            {% if loop.first %}
                                <td rowspan="{{ constant('EtoA\\Universe\\Resources\\ResourceNames::NAMES')|length }}">
                                    {{ offer.vars.data.count }} {{ offer.vars.data.ship.name }}
                                </td>
                            {% endif %}
                            <td class="rescolor{{ rk }}"> {{ constant('EtoA\\Universe\\Resources\\ResIcons::ICONS')[rk]|raw }}  <b> {{ rn }} </b>:</td>
                            <td class="rescolor{{ rk }}"> {{ (offer.vars.data.costs.get(rk) > 0 ?
                                formatNumber(offer.vars.data.costs.get(rk)) : '-') }} </td>
                            {% if loop.first %}
                                <td rowspan="5"> {{ offer.vars.data.date|date("d.m.Y  G:i:s") }}<br/><br/>
                                    {{ offer.vars.data.text }}
                                </td>
                                <td rowspan="5" {{tm('','Wenn du das Angebot zurückziehst erhälst du '~(returnFactor * 100)~
                                '% des Angebotes zurück (abgerundet)')|raw}}>
                                    {{form_widget(offer.checkbox)}}
                                    <br/><br/>
                                    {% if offer.vars.data.forUser %}
                                        <span class="userAllianceMemberColor">Für Spieler {{ offer.vars.data.forUser }} reserviert</span>
                                    {% elseif offer.vars.data.forAlliance %}
                                        <span class="userAllianceMemberColor">Für Allianzmitglied Reserviert</span>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                    {% if not loop.last %}
                        <tr><td colspan="7" style="height:10px;background:#000"></td></tr>
                    {% endif %}
                {% endfor %}
            {% endblock %}
        </twig:Table>
        {{ form_widget(formShip.submit) }}
        {{ form_widget(formShip.checker) }}
        {{ form_end(formShip) }}<br/><br/>
    {% else %}
        {{ macros.message('Schiffe','Keine Angebote vorhanden!') }}
    {% endif %}



    {% if formAuction.offers.vars.data %}
        {{ form_start(formAuction) }}
        <twig:Table title="Rohstoffe">
            {% block table_content %}
                <tr>
                    <th>Angebot</th>
                    <th>Beschreibung</th>
                    <th style="width:100px;">Angebotsende</th>
                    <th style="width:50px;">Gebote</th>
                    <th>Aktuelles Gebot</th>
                    <th>Zurückziehen</th>
                </tr>
                {% for offer in formAuction.offers %}
                    <td>
                        {% for rk,rn in constant('EtoA\\Universe\\Resources\\ResourceNames::NAMES') %}
                            {% if offer.vars.data.getSellResources.get(rk) > 0 %}
                                <span class="rescolor{{ rk }}"> {{ constant('EtoA\\Universe\\Resources\\ResIcons::ICONS')[rk]|raw }}  <b> {{ rn }} </b>:</span>
                                <span class="rescolor{{ rk }}"> {{ formatNumber(offer.vars.data.getSellResources.get(rk)) }} </span>
                            {% endif %}
                        {% endfor %}
                    </td>
                    <td>{{ offer.vars.data.text }}</td>
                    <td>
                        {% if (offer.vars.data.dateEnd - date().timestamp) <= 0 %}
                            Auktion beendet!
                        {% else %}
                            {{ formatTimespan(offer.vars.data.dateEnd - date().timestamp) }}
                        {% endif %}
                    </td>
                    <td>{{ offer.vars.data.bidCount }}</td>
                    <td>
                        {% for rk,rn in constant('EtoA\\Universe\\Resources\\ResourceNames::NAMES') %}
                            {% if offer.vars.data.getBuyResources.get(rk) > 0 %}
                                <span class="rescolor{{ rk }}"> {{ constant('EtoA\\Universe\\Resources\\ResIcons::ICONS')[rk]|raw }}  <b> {{ rn }} </b>:</span>
                                <span class="rescolor{{ rk }}"> {{ offer.vars.data.getBuyResources.get(rk) }}</span>
                            {% endif %}
                        {% endfor %}
                    </td>
                    <td {{tm('','Wenn du das Angebot zurückziehst erhälst du '~(returnFactor * 100)~
                    '% des Angebotes zurück (abgerundet)')|raw}}>
                        {% if (offer.vars.data.dateEnd - date().timestamp) > 0 and offer.vars.data.bidCount == 0 and offer.vars.data.buyable %}
                            {{form_widget(offer.checkbox)}}
                        {% endif %}
                    </td>
                    {% if not loop.last %}
                        <tr><td colspan="6" style="height:10px;background:#000"></td></tr>
                    {% endif %}
                {% endfor %}
            {% endblock %}
        </twig:Table>
        {{ form_widget(formAuction.submit) }}
        {{ form_widget(formAuction._token) }}
        {{ form_widget(formAuction.checker) }}
        {{ form_end(formAuction,{render_rest:false}) }}<br/><br/>
    {% else %}
        {{ macros.message('Auktionen','Keine Auktionen vorhanden!') }}
    {% endif %}


{% endblock %}
{% extends 'layout/game.html.twig' %}
{% block content %}
    <h1>Forschungslabor (Stufe {{ researchBuilding.currentLevel }}) des Planeten {{ planet.name }}</h1>

    <twig:ResourceBox/>

    <twig:Table title="Allgemeine-Infos">
    {% block table_content %}
        <colgroup>
            <col style="width:400px;"/><col/>
        </colgroup>
        {% if app.user.data.specialist and app.user.data.specialist.costsTechnologies != 1 %}
            <tr>
                <td>Kostenreduktion durch {{ app.user.data.specialist.name }}</td>
                <td>{{ formatPercentString(app.user.data.specialist.costsTechnologies) }}</td>
            </tr>
        {% endif %}
        {% if app.user.data.specialist and app.user.data.specialist.timeTechnologies != 0 %}
            <tr>
                <td>Forschungszeitverringerung durch {{ app.user.data.specialist.name }}:</td>
                <td>{{ formatPercentString(app.user.data.specialist.timeTechnologies) }}</td></tr>
        {% endif %}
        <tr>
            <td>Forschungszeitverringerung:</td>
            <td>
                {% if (researchBuilding.currentLevel - configValue('build_time_boni_forschungslabor')) >= 0 %}
                {{ formatPercentString(max(param2('build_time_boni_forschungslabor'), 1 - ((researchBuilding.currentLevel -
                    configValue('build_time_boni_forschungslabor')) * (configValue('build_time_boni_forschungslabor') /
                    100)))) }} durch Stufe {{ researchBuilding.currentLevel }} (-{{ ((1 -
            param2('build_time_boni_forschungslabor')) * 100) }}% maximum)
                {% else %}
                    Stufe {{ configValue('build_time_boni_forschungslabor') }} erforderlich!
                {% endif %}
            </td>
        </tr>
        {% if genTechLevel %}
            <tr>
                <td>Gentechnologie:</td>
                <td>{{ genTechLevel }}</td>
            </tr>
            <tr>
                <td>Minimale Forschungszeit (mit Arbeiter):</td>
                <td>Forschungszeit * {{ (0.1 - (genTechLevel / 100)) }}</td></tr>
        {% endif %}
    {% endblock %}
    </twig:Table>

    <twig:Table title="Labor-Infos">
    {% block table_content %}
        <colgroup>
            <col span="3" style="width:400px;"/>
        </colgroup>
        <tr>
            <th></th>
            <th>Normal</th>
            <th>Gentech</th>
        </tr>
        <tr>
            <td>Eingestellte Arbeiter:</td>
            <td>
                {{ formatNumber(researchBuilding.peopleWorking) }}
                if (($building_something <> 1) && ($bid > 0) && ($bid <> 23)) {
                &nbsp;<a id ="link" href="javascript:;" onclick="toggleBox(\'changePeople\');">[Ändern]</a>
                }
            </td>
            <td>
                {{ genBuilding?formatNumber(genBuilding.peopleWorking):0 }}
                if (($building_gen <> 1) && ($bid == 23)) {
                &nbsp;<a id ="link" href="javascript:;" onclick="toggleBox(\'changePeople\');">[Ändern]</a>
                }
            </td>
        </tr>
        {% if genBuilding.peopleWorking > 0 or researchBuilding.peopleWorking > 0 %}
            <tr>
                <td>Zeitreduktion durch Arbeiter pro Auftrag:</td>
                <td>{{ formatTimespan(configValue('people_work_done') * researchBuilding.peopleWorking) }}</td>
                <td>{{ formatTimespan(configValue('people_work_done') * genBuilding.peopleWorking) }}</td>
            </tr>
            <tr>
                <td>Nahrungsverbrauch durch Arbeiter pro Auftrag:</td>
                <td>{{ formatNumber(configValue('people_food_require') * researchBuilding.peopleWorking) }}</td>
                <td>{{ formatNumber(configValue('people_food_require') * genBuilding.peopleWorking) }}</td>
            </tr>
        {% endif %}
    {% endblock %}
    </twig:Table>

    {% block research %}

    {% endblock %}
{% endblock %}
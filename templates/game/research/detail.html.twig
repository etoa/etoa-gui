{% extends 'game/research/research.html.twig' %}

{% block research %}
    <twig:Table title="{{ technology.technology.name~" "~technology.currentLevel }}">
    {% block table_content %}
        <tr>
            <td rowspan="3" style="background:#000;;vertical-align:middle;">
                <a href="">
                    <img src="{{ technology.technology.getImagePath('other') }}" alt="{{ technology.technology.name }}" style="border:none;width:220px;height:220px"/>
                </a>
            </td>
            <td colspan="2">{{ BBCodeToHTML(technology.technology.shortComment)|raw }}</td>
        </tr>
        <tr>
            <th height="20">Status:</th>
            {% if technology.buildType == 3 %}
                <td id="buildstatus" style="color:#0f0;">Wird erforscht</td>
            {% else %}
                <td id="buildstatus">Untätig</td>
            {% endif %}
        </tr>
        <tr>
            <th height="20">Stufe:</th>
            {% if technology.currentLevel > 0 %}
                <td id="buildlevel">{{ technology.currentLevel }}</td>
             {% else %}
                 <td id="buildlevel">Noch nicht erforscht</td>
            {% endif %}
        </tr>
    {% endblock %}
    </twig:Table>
    <twig:Table title="Forschoptionen">
    {% block table_content %}
        <tr>
            <th>Aktion</th>
            <th>Zeit</th>
            <th> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::METAL') }} </th>
            <th> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::CRYSTAL') }} </th>
            <th> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::PLASTIC') }} </th>
            <th> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::FUEL') }} </th>
            <th> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::FOOD') }} </th>
        </tr>
    {% endblock %}
    </twig:Table>
    
    <input type="submit" name="command_show" value="Aktualisieren" /> &nbsp;
    <a href="{{ path('game.research') }}">
        <input type="button" value="Zurück zur Übersicht"/>
    </a>
{% endblock %}
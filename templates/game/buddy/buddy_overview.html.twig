{% extends 'game/buddy/buddy.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block buddy %}
    {% if msg.success is defined %}
        {{ macros.successMessage(BBCodeToHTML(msg.success))|raw }}
    {% endif %}

    {% if msg.error is defined %}
        {{ macros.errorMessage(BBCodeToHTML(msg.error))|raw }}
    {% endif %}

    {% if buddies %}
        <twig:Table title="Meine Freunde">
        {% block table_content %}
            <tr>
                <th>Nick</th>
                <th>Punkte</th>
                <th>Hauptplanet</th>
                <th>Online</th>
                <th>Kommentar</th>
                <th>Aktion</th>
            </tr>
            {% for buddy in buddies %}
                <tr>
                    <td> {{ buddy.buddy.nick }} </td>
                    {% if buddy.allowed %}
                        <td>{{ formatNumber(buddy.buddy.points) }}</td>
                        {% set mainPlanet = planetRepository.getUserMain(buddy.buddy) %}
                        <td>
                            {% if mainPlanet %}
                                <a href="{{ path('game.cell', {id: mainPlanet.entity.cell.id, hl: mainPlanet.entity.id}) }}">{{ mainPlanet.name }}</a>
                            {% else %}
                                Noch kein Hauptplanet vorhanden!
                            {% endif %}
                        </td>
                        {% if sessionRepository.findOneBy({user:buddy.buddy}) %}
                            <td style="color:#0f0;">online</td>
                        {% elseif sessionLogRepository.findOneBy({user:buddy.buddy},{timeAction:'DESC'},1) %}
                            <td> {{ formatTimestamp(sessionLogRepository.findOneBy({user:buddy.buddy},{timeAction:'DESC'},1).timeAction) }} </td>
                        {% else %}
                            <td>Noch nicht eingeloggt!</td>
                        {% endif %}
                    {% else %}
                        <td colspan="3"><i>Noch keine Erlaubnis</i></td>
                    {% endif %}
                    <td>
                        {% if buddy.comment %}
                            {{ BBCodeToHTML(buddy.comment) }}
                        {% endif %}
                    </td>
                    <td>
                        {# messages and userinfo take a user id, comment and remove take the buddy row id #}
                        <a href="{{ path('game.messages.newTo',{id:buddy.buddy.id}) }}" title="Nachricht">Nachricht</a>
                        <a href="{{ path('game.userinfo',{id:buddy.buddy.id}) }}" title="Info">Profil</a><br/>
                        <a href="{{ path('game.buddylist.comment',{id:buddy.id}) }}" title="Kommentar bearbeiten">Kommentar</a>
                        <a href="{{ path('game.buddylist.remove',{id:buddy.id}) }}" onclick="return confirm('Willst du  {{ buddy.buddy.nick }}  wirklich von deiner Liste entfernen?');">Entfernen</a>
                    </td>
                </tr>
            {% endfor %}
        {% endblock %}
        </twig:Table>
    {% else %}
        <twig:Box title="Information" class="information">
            Es sind noch keine Freunde in deiner Buddyliste eingetragen!
        </twig:Box>
    {% endif %}

    {% if pendings %}
        <twig:Table title="Offene Anfragen">
            {% block table_content %}
                <tr>
                    <th class="tbltitle">Nick</th>
                    <th class="tbltitle">Punkte</th>
                    <th class="tbltitle">Aktion</th>
                </tr>
                {% for pending in pendings %}
                    <tr>
                        <td class="tbldata"> {{ pending.user.nick }} </td>
                        <td> {{ formatNumber(pending.user.points) }} </td>
                        <td style="width:280px;">
                            {# in a pending row "user" is the requester, "buddy" is the current user #}
                            <a href="{{ path('game.messages.newTo',{id:pending.user.id}) }}" title="Nachricht">Nachricht</a>
                            <a href="{{ path('game.userinfo',{id:pending.user.id}) }}" title="Info">Profil</a>
                            <a href="{{path('game.buddylist.accept',{id:pending.id})}}" style="color:#0f0">Annehmen</a>
                            <a href="{{path('game.buddylist.deny',{id:pending.id})}}" style="color:#f90">Zurückweisen</a>
                        </td>
                    </tr>
                {% endfor %}
            {% endblock %}
        </twig:Table>
    {% endif %}

    <h2>Füge einen Freund hinzu:</h2>
    {{ form_start(form) }}
        <twig:UserNickSearch boxId="form_user" field="{{ form_widget(form.user) }}"/>
        {{ form_widget(form.submit) }}
    {{ form_end(form) }}
{% endblock %}
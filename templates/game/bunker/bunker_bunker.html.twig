{% extends 'game/bunker/bunker.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block bunker %}
    {% if msg.success is defined %}
        {{ macros.successMessage(msg.success) }}
    {% endif %}

    {{ form_start(form) }}
        <twig:Table title="Flottenbunker">
            {% block table_content %}
                <tr>
                    <th colspan="5">Schiffe wählen:</th>
                </tr>
                <tr>
                    <th colspan="2">Typ</th>
                    <th>Struktur</th>
                    <th>Eingebunkert</th>
                    <th>Ausbunkern</th>
                </tr>
                {% for ship in form.bunkered %}
                    <tr>
                        {% if ship.vars.data.ship.special %}
                            <td style="width:40px;background:#000;">
                                <img src="{{ ship.vars.data.ship.getImagePath('small') }}" width="40" height="40" alt="Ship"/>
                            </td>
                        {% else %}
                            <td style="width:40px;background:#000;">
                                <a href="{{ path('game.help.shipyard.detail',{id:ship.vars.data.ship.id}) }}">
                                    <img src="{{ ship.vars.data.ship.getImagePath('small') }}" width="40" height="40" alt="Ship"/>
                                </a>
                            </td>
                        {% endif %}
                        <td {{ tm(ship.vars.data.ship.name,
                            "<img src=\""~ship.vars.data.ship.getImagePath('medium')~"\" style=\"float:left;margin-right:5px;\">"~
                            BBCodeToHTML(ship.vars.data.ship.shortComment))|raw }} >
                            {{ ship.vars.data.ship.name }} </td>
                        <td> {{ formatNumber(ship.vars.data.ship.structure) }} </td>
                        <td> {{ formatNumber(ship.vars.data.bunkered) }} </td>
                        <td>
                            {{ form_widget(ship.children.bunkered) }}
                            <br/>
                            <a href="javascript:;" onclick="document.getElementById('{{ ship.children.bunkered.vars.id }}').value={{ ship.vars.data.bunkered }};document.getElementById('{{ship.children.bunkered.vars.id}}').select()">Alle</a> &nbsp;
                            <a href="javascript:;" onclick="document.getElementById('{{ ship.children.bunkered.vars.id }}').value=0;">Keine</a>
                        </td>
                    </tr>
                {% endfor %}
            <tr>
                <th colspan="2">Benutzt:</th>
                <td> {{ formatNumber(structure) }} / {{ formatNumber(totalStructure) }} </td>
                <td> {{ formatNumber(count) }} / {{ formatNumber(totalCount) }} </td>
                <td>
                    <a href="javascript:;" onclick="">Alle wählen</a>
                </td>
            </tr>
                <tr>
                    <th colspan="2">Verfügbar:</th>
                    <td>
                        <img src="/images/progress/{{ (structure / totalStructure * 100)|round }}?r=1&w=100" alt="progress" />
                    </td>
                    <td>
                        <img src="/images/progress/{{ (count / totalCount * 100)|round }}?r=1&w=100" alt="progress" />
                    </td>
                    <td></td>
                </tr>
            {% endblock %}
        </twig:Table>
        {{ form_widget(form.submit) }}
    {{ form_widget(form.checker) }}
    {{ form_end(form) }}
{% endblock %}
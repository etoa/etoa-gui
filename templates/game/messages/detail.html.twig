{% extends 'game/messages/messages.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block messages %}
    {% if msg.success is defined %}
        {{ macros.successMessage(msg.success) }}
    {% endif %}

    <twig:Table>
        {% block table_content %}
            <tr>
                <th colspan="2">{{ message.messageData.subject??'<i>Kein Titel</i>'|raw }}</th>
            </tr>
            <tr>
                <th style="width:100px;">Datum:</th>
                <td>{{ formatTimestamp(message.timestamp) }}</td>
            </tr>
            <tr>
                <th>Empfänger:</th>
                <td>
                    <div id="ttuser{{ message.userFrom.id }}" style="display:none;">
                        <a href="{{ path('game.userinfo',{id:message.userFrom.id, popup:1}) }}"
                           onclick="window.open('{{ path('game.userinfo',{id:message.userFrom.id, popup:1}) }}','popup','status=no,width=800,height=600,scrollbars=yes');return false;">Profil
                            anzeigen</a> <br>
                        <a href="{{ path('game.stats.userdetail',{id:message.userFrom.id, popup:1}) }}"
                           onclick="window.open('{{ path('game.stats.userdetail',{id:message.userFrom.id, popup:1}) }}','popup','status=no,width=800,height=600,scrollbars=yes');return false;">Punkteverlauf</a>
                        <br>
                    </div>
                    <a href="#"
                       onclick="showTT('{{ message.userFrom.nick }}','ttuser{{ message.userFrom.id }}',0,event,this);return false;">{{ message.userFrom.nick }}</a>
                </td>
            </tr>
            <tr>
                <th>Text:</th>
                <td>{{ message.messageData.text|raw }}</td>
            </tr>
        {% endblock %}
    </twig:Table>
    {% if message.deleted %}
        {{ form_start(form) }}
            <a href="{{ path('game.messages.sent') }}">
                <input type="button" value="Zurück"/>
            </a>
            {{ form_widget(form.restore) }}
        {{ form_end(form) }}
    {% else %}
        <a href="{{ path('game.messages.sent') }}">
            <input type="button" value="Zurück"/>
        </a>
    {% endif %}
{% endblock %}
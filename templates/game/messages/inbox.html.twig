{% extends 'game/messages/messages.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block messages %}
    {% if msg.success is defined %}
        {{ macros.successMessage(msg.success) }}
    {% endif %}

    <twig:Table title="Nachrichten">
        {% block table_content %}
            <tr>
                <th style="text-align:center;width:50%; {{ rColor }}">
                    Gelesen: {{ readMessagesCount }} / {{ configValue('msg_max_store') }} Nachrichten
                </th>
                <th style="text-align:center;width:50%; {{ aColor }}">
                    Archiviert: {{ archivedMessagesCount }} / {{ configValue('msg_max_store') }} Nachrichten
                </th>
            </tr>
            <tr>
                <td style="padding:0;height:10px;"><img src="{{ asset('/build/images/poll3.jpg') }}" style="height:10px;width:{{ percentRead }}%;" alt="poll" /></td>
                <td style="padding:0;height:10px;"><img src="{{ asset('/build/images/poll2.jpg') }}" style="height:10px;width:{{ percentArchived }}%;" alt="poll" /></td>
            </tr>
        {% endblock %}
    </twig:Table>

    {{ form_start(form) }}
        <twig:Table title="Kategorien">
        {% block table_content %}
            {% set messagesReadCount = 0 %}
            {% for category,messages in form.children %}
                {% if messages.children %}
                    <tr>
                        <th colspan="4"> {{ BBCodeToHTML(messageCat.find(category).name)|raw }} ({{ messages.children|length }} Nachrichten)</th>
                        <th style="text-align:center;">
                            <input type="button" value="X" onclick="toggleCheckboxGroup(this, '{{ messages.vars.full_name }}[')"/>
                        </th>
                    </tr>
                    {% for message in messages.children %}
                        {% if message.vars.data.read %}
                            <tr id="msg_id_{{ message.vars.data.id }}">
                            {% set messagesReadCount = messagesReadCount+1 %}
                        {% else %}
                            <tr>
                        {% endif %}
                            <td class='messageCellIcon' style="width:2%;">
                                <img src="{{ message.vars.data.read?asset('/build/images/pm_normal.gif'):asset('/build/images/pm_new.gif') }}" alt="Mail" id="msgimg{{ message.vars.data.id }}" />
                            </td>
                            <td class='messageCellSubject' style="width:66%;"
                                {% if app.user.data.userProperties.msgPreview %}
                                    {{ tm(message.vars.data.messageData.subject?'<i>'~message.vars.data.messageData.subject~'</i>':'<i>Kein Titel</i>',BBCodeToHTML(message.vars.data.messageData.text))|raw }}
                                {% endif %}
                            >
                                {% if message.vars.data.massMail %}
                                    <b>[Rundmail]</b>
                                {% endif %}
                                {% if messagesReadCount >= configValue('msg_max_store') %}
                                    <span style="color:red;">{{ message.vars.data.messageData.subject }}</span>
                                {% else %}
                                    {% if app.user.data.userProperties.msgPreview %}
                                        <a href="javascript:;" data-message="{{ message.vars.data.id }}" data-read="{{ message.vars.data.isRead }}" class="openMessage" onclick="toggleBox('msgtext{{ message.vars.data.id }}')">
                                            {{ message.vars.data.messageData.subject }}
                                        </a>
                                    {% else %}
                                        <a href="{{path('game.messages.show',{id:message.vars.data.id})}}">{{ message.vars.data.messageData.subject }}</a>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class='messageCellFrom' style="width:15%;">
                                {% if message.vars.data.userFrom and message.vars.data.userFrom.id > 0 %}
                                    <div id="ttuser{{ message.vars.data.userFrom.id }}" style="display:none;">
                                        <a href="{{ path('game.userinfo',{id:message.vars.data.userFrom.id, popup:1}) }}" onclick="window.open('{{ path('game.userinfo',{id:message.vars.data.userFrom.id, popup:1}) }}','popup','status=no,width=800,height=600,scrollbars=yes');return false;">Profil anzeigen</a> <br>
                                        <a href="{{ path('game.stats.userdetail',{id:message.vars.data.userFrom.id, popup:1}) }}" onclick="window.open('{{ path('game.stats.userdetail',{id:message.vars.data.userFrom.id, popup:1}) }}','popup','status=no,width=800,height=600,scrollbars=yes');return false;">Punkteverlauf</a> <br>
                                    </div>
                                    <a href="#" onclick="showTT('{{ message.vars.data.userFrom.nick }}','ttuser{{ message.vars.data.userFrom.id }}',0,event,this);return false;">{{ message.vars.data.userFrom.nick }}</a>
                                {% elseif message.vars.data.userFrom and message.vars.data.userFrom.id == 0 %}
                                    <i>System</i>
                                {% else %}
                                    <i>{{ message.vars.data.cat and message.vars.data.cat.sender ? message.vars.data.cat.sender : 'System' }}</i>
                                {% endif %}
                            </td>
                            <td class='messageCellDate' style="width:15%;">
                                {{ formatTimestamp(message.vars.data.timestamp) }}
                            </td>
                            <td class='messageCellAction' style="width:2%;text-align:center;padding:0;vertical-align:middle;">
                                {{ form_widget(message) }}
                            </td>
                        </tr>
                        {% if app.user.data.userProperties.msgPreview %}
                            <tr style="display:none;" id="msgtext{{ message.vars.data.id }}">
                                <td colspan="5" class="tbldata">
                                    {{ BBCodeToHTML(message.vars.data.messageData.text)|raw }}
                                    <br/><br/>
                                    <a href="{{ path('game.messages.remit',{id:message.vars.data.id}) }}">
                                        <input type="button" value="Weiterleiten"/>&nbsp;
                                    </a>
                                        {% if message.vars.data.userFrom and message.vars.data.userFrom.id > 0 %}
                                            <a href="{{path('game.messages.reply',{id:message.vars.data.id})}}">
                                                <input type="button" value="Antworten" name="answer" />&nbsp;
                                            </a>
                                            <a href="{{ path('game.messages.toggleIgnore',{id:message.vars.data.userFrom.id}) }}">
                                                <input type="button" value="Absender ignorieren"/>&nbsp;
                                            </a>
                                        {% endif %}
                                    <a href="{{ path('game.messages.delete',{id:message.vars.data.id}) }}">
                                        <input type="button" value="Löschen"/>&nbsp;
                                    </a>
                                    {% if message.vars.data.userFrom %}
                                        <twig:ticketbutton cat="1" title="Beleidigung melden"/>
                                    {% else %}
                                        <twig:ticketbutton cat="8" title="Regelverstoss melden"/>
                                    {% endif %}
                                    <br/>
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    {% if messageCat.find(category) %}
                        <tr>
                            <th colspan="5">{{ BBCodeToHTML(messageCat.find(category).name)|raw }}</th>
                        </tr>
                        <tr>
                            <td colspan="5"><i>Keine Nachrichten vorhanden</i></td>
                        </tr>
                    {% endif %}
                {% endif %}
            {% endfor %}
        {% endblock %}
        </twig:Table>
        {{ form_widget(form.delete) }}&nbsp;
        {{ form_widget(form.deleteAll) }}&nbsp;
        {{ form_widget(form.deleteSystem) }}&nbsp;
        {{ form_widget(form.archive) }}&nbsp;
    {{ form_end(form) }}
{% endblock %}
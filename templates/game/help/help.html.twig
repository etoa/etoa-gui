{% extends app.request.query.get('popup')
    ? 'layout/base.html.twig'
    : 'layout/game.html.twig' %}

{% set currentContent %}
    <h1>Hilfe</h1>

    {% block help %}
    {% endblock %}
{% endset %}

{% if app.request.query.get('popup') %}
    {% set bodyTopStuff %}
        <div id="contentwrap">
            {{ currentContent }}
        </div>
    {% endset %}
{% else %}
    {% set content %}
        {{ currentContent }}
    {% endset %}
{% endif %}
{% extends 'game/help/help.html.twig' %}

{% block help %}
    <h2>Gebäude</h2>

    {% block breadcrumbs %}
        {{ component('breadcrumbs', { items: [
            { label: 'Hilfe', url: path('game.help.overview') },
            { label: 'Gebäude', url: path('game.help.buildings') },
        ], title:"Du befindest dich hier:"}) }}
    {% endblock %}<br/>

    {% if infos.building %}
        <twig:Table title="{{ infos.building.name }}">
            {% block table_content %}
                <tr>
                    <th style="width:220px;background:#000;padding:0" rowspan="2">
                        <img src="{{ building.getImagePath('other') }}"
                             style="width:220px;height:220px;background:#000;margin:0"
                             alt="Bild {{ infos.building.name }}"/>
                    </th>
                    <td colspan="2">
                        <div>{{ BBCodeToHTML(infos.building.longComment) }}</div>
                    </td>
                </tr>
                <tr>
                    <th style="height:20px;width:120px;">Maximale Stufe:</th>
                    <td style="height:20px;">{{ infos.building.lastLevel }}</td>
                </tr>
            {% endblock %}
        </twig:Table>
        <twig:Table title="{{ infos.title }}">
            {% block table_content %}
                <tr>
                    <th>Rohstoff</th>
                    <th>Prod.</th>
                    <th>Lager</th>
                </tr>
                <tr>
                    <td>{{ constant('EtoA\\Universe\\Resources\\ResourceNames::METAL') }}</td>
                    <td>{{ formatNumber(building.prodMetal) }}</td>
                    <td>{{ formatNumber(building.storeMetal) }}</td>
                </tr>
                <tr>
                    <td>{{ constant('EtoA\\Universe\\Resources\\ResourceNames::CRYSTAL') }}</td>
                    <td>{{ formatNumber(building.prodCrystal) }}</td>
                    <td>{{ formatNumber(building.storeCrystal) }}</td>
                </tr>
                <tr>
                    <td>{{ constant('EtoA\\Universe\\Resources\\ResourceNames::PLASTIC') }}</td>
                    <td>{{ formatNumber(building.prodPlastic) }}</td>
                    <td>{{ formatNumber(building.storePlastic) }}</td>
                </tr>
                <tr>
                    <td>{{ constant('EtoA\\Universe\\Resources\\ResourceNames::FUEL') }}</td>
                    <td>{{ formatNumber(building.prodFuel) }}</td>
                    <td>{{ formatNumber(building.storeFuel) }}</td>
                </tr>
                <tr>
                    <td>{{ constant('EtoA\\Universe\\Resources\\ResourceNames::FOOD') }}</td>
                    <td>{{ formatNumber(building.prodFood) }}</td>
                    <td>{{ formatNumber(building.storeFood) }}</td>
                </tr>
                <tr>
                    <td>Bewohner</td>
                    <td>-</td>
                    <td>{{ formatNumber(building.peoplePlace) }} Plätze</td>
                </tr>
                <tr>
                    <td>Energie</td>
                    <td>{{ formatNumber(building.prodPower) }}</td>
                    <td>-</td>
                </tr>
            {% endblock %}
        </twig:Table>
        <twig:Table title="Kostenentwicklung (Faktor: {{ building.buildCostsFactor }})">
            {% block table_content %}
                <tr>
                    <th style="text-align:center;">Level</th>
                    <th>{{ constant('EtoA\\Universe\\Resources\\ResIcons::METAL')|raw }} {{ constant('EtoA\\Universe\\Resources\\ResourceNames::METAL') }}</th>
                    <th>{{ constant('EtoA\\Universe\\Resources\\ResIcons::CRYSTAL')|raw }}  {{ constant('EtoA\\Universe\\Resources\\ResourceNames::CRYSTAL') }}</th>
                    <th>{{ constant('EtoA\\Universe\\Resources\\ResIcons::PLASTIC')|raw }}  {{ constant('EtoA\\Universe\\Resources\\ResourceNames::PLASTIC') }}</th>
                    <th>{{ constant('EtoA\\Universe\\Resources\\ResIcons::FUEL')|raw }}  {{ constant('EtoA\\Universe\\Resources\\ResourceNames::FUEL') }}</th>
                    <th>{{ constant('EtoA\\Universe\\Resources\\ResIcons::FOOD')|raw }}  {{ constant('EtoA\\Universe\\Resources\\ResourceNames::FOOD') }}</th>
                    <th>Felder</th>
                </tr>
                {% for level,cost in infos.costs %}
                    <tr>
                        <td>{{ level+1 }}</td>
                        <td style="text-align:right;">{{ formatNumber(cost.metal) }}</td>
                        <td style="text-align:right;">{{ formatNumber(cost.crystal) }}</td>
                        <td style="text-align:right;">{{ formatNumber(cost.plastic) }}</td>
                        <td style="text-align:right;">{{ formatNumber(cost.fuel) }}</td>
                        <td style="text-align:right;">{{ formatNumber(cost.food) }}</td>
                        <td style="text-align:right;">{{ formatNumber(building.fields * (level + 1)) }}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        </twig:Table>
        {{ component('game_techtree',{headline:'Technikbaum',showSelection:false,item:building}) }}
    {% endif %}
    <a href="{{ path('game.help.buildings') }}">
        <input type="button" value="Gebäudeübersicht"/>
    </a>
    &nbsp;
    <a href="{{ path('game.help.overview') }}">
        <input type="button" value="Zurück"/>
    </a>
    &nbsp;

{% endblock %}
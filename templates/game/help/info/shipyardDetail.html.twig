{% extends 'game/help/help.html.twig' %}

{% block help %}

    <h2>Schiffe</h2>

    {% block breadcrumbs %}
        {{ component('breadcrumbs', { items: [
            { label: 'Hilfe', url: path('game.help.overview') },
            { label: 'Schiffe', url: path('game.help.shipyard') },
        ], title:"Du befindest dich hier:"}) }}
    {% endblock %}<br/>

    {% if ship and ship.show %}
        <twig:Table title="{{ ship.name }}">
            {% block table_content %}
                <tr>
                    <td class="tbltitle" style="width:220px;background:#000">
                        <img src="{{ ship.getImagePath('other') }}" width="220" height="220" alt="Schiff"/>
                    </td>
                    <td class="tbldata" colspan="3">
                        {{ BBCodeToHTML(ship.longComment) }}
                    </td>
                </tr>
                {% if ship.race and ship.race.id > 0 %}
                    <tr>
                        <th class="tbltitle">Rasse:</th>
                        <td colspan="3" class="tbldata">Dieses Schiff kann exklusiv nur durch das Volk der <b>
                                {{ ship.race.name }}</b> gebaut werden!
                        </td>
                    </tr>
                {% endif %}
                <tr>
                    <th class="tbltitle">Bewertung:
                    </th>
                    <td class="tbldata" colspan="3">
                        {{ shipRanking|raw }}
                    </td>
                </tr>
                <tr>
                    <th class="tbltitle">Kategorie:</th>
                    <td class="tbldata" colspan="3">{{ ship.cat.name }}</td>
                </tr>
                <tr>
                    <th class="tbltitle">Anzahl Piloten:</th>
                    <td class="tbldata" colspan="3">{{ formatNumber(ship.pilots) }}</td>
                </tr>
                <tr>
                    <td colspan="4" style="height:30px;"></td>
                </tr>
                <tr>
                    <th class="tbltitle" colspan="2" style="text-align:center">Kosten</th>
                    <th class="tbltitle" colspan="2" style="text-align:center">Technische Daten</th>
                </tr>
                <tr>
                    <td style="padding:0">
                        <table class="tb">
                            <tr>
                                <td style="width:170px;font-weight:bold;" class="resmetal">
                                    {{ constant('EtoA\\Universe\\Resources\\ResourceNames::METAL') }}
                                </td>
                                <td style="width:350px">{{ formatNumber(ship.costsMetal) }} t</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;" class="rescrystal">
                                    {{ constant('EtoA\\Universe\\Resources\\ResourceNames::CRYSTAL') }}
                                </td>
                                <td style="width:350px">{{ formatNumber(ship.costsCrystal) }} t</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;" class="resplastic">
                                    {{ constant('EtoA\\Universe\\Resources\\ResourceNames::PLASTIC') }}
                                </td>
                                <td style="width:350px">{{ formatNumber(ship.costsPlastic) }} t</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;" class="resfuel">
                                    {{ constant('EtoA\\Universe\\Resources\\ResourceNames::FUEL') }}
                                </td>
                                <td style="width:350px">{{ formatNumber(ship.costsFuel) }} t</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;" class="resfood">
                                    {{ constant('EtoA\\Universe\\Resources\\ResourceNames::FOOD') }}
                                </td>
                                <td style="width:350px">{{ formatNumber(ship.costsFood) }} t</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;" class="resfuel">/100 AE</td>
                                <td style="width:350px">{{ formatNumber(ship.fuelUse) }} t</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;" class="resfuel">Start</td>
                                <td style="width:350px">{{ formatNumber(ship.fuelUseLaunch) }} t</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;" class="resfuel">Landung</td>
                                <td style="width:350px">{{ formatNumber(ship.fuelUseLanding) }} t
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td colspan="3" style="padding:0">
                        <table class="tb" style="width:100%">
                            <tr>
                                <td style="font-weight:bold;">Struktur</td>
                                <td>{{ formatNumber(ship.structure) }}</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Schutzschild</td>
                                <td>{{ formatNumber(ship.shield) }}</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Waffen</td>
                                <td>{{ formatNumber(ship.weapon) }}</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Heilung</td>
                                <td>{{ formatNumber(ship.heal) }}</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Antriebstechnologie</td>
                                <td>
                                    {% for technology in technologies %}
                                        <a href="{{ path('game.help.research.detail',{id:technology.tech.id}) }}">
                                            {{ technology.tech.name }}</a> (Stufe {{ technology.level }})<br/>
                                    {% endfor %}
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Laderaum</td>
                                <td>{{ formatNumber(ship.capacity) }} t</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Passagierraum</td>
                                <td>{{ formatNumber(ship.peopleCapacity) }}</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Geschwindigkeit</td>
                                <td>{{ formatNumber(ship.speed / configValue('flight_flight_time')) }} AE/h</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Startdauer</td>
                                <td>{{ formatTimespan(ship.timeToStart / configValue('flight_start_time')) }}</td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Landedauer</td>
                                <td>{{ formatTimespan(ship.timeToLand / configValue('flight_land_time')) }}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="height:30px;"></td>
                </tr>
                <tr>
                    <th class="tbltitle" colspan="4" style="text-align:center">Fähigkeiten</th>
                </tr>
                {% if actions|length > 0 %}
                    <tr>
                        <td colspan="4" style="padding:0">
                            <table class="tb" style="width:100%">
                                {% for action in actions %}
                                    <tr>
                                        <td class="tbldata" style="width:150px;">{{ action|raw }}</td>
                                        <td class="tbldata">{{ action.desc|raw }}</td>
                                        <td class="tbldata" style="width:150px;">
                                            <a href="{{ path('game.help.action.detail',{code:action.code}) }}">Details</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="tbldata" colspan="4" style="text-align:center">Keine Spezialfähigkeit vorhanden!
                        </td>
                    </tr>
                {% endif %}
                <tr>
                    <td colspan="4" style="height:30px;"></td>
                </tr>
                <tr>
                    <th class="tbltitle" colspan="4" style="text-align:center">Voraussetzungen</th>
                </tr>
                <tr>
                    <td class="tbldata" colspan="4" style="text-align:center">
                        {{ component('game_techtree',{headline:'',item:ship,showSelection:false}) }}
                    </td>
                </tr>
            {% endblock %}
        </twig:Table>
    {% endif %}
    &nbsp;
    <a href="{{ path('game.help.shipyard') }}">
        <input type="button" value="Schiffsübersicht"/>
    </a>
{% endblock %}
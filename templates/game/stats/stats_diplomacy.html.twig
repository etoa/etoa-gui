{% extends 'game/stats/stats_pagination.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block pagination %}
    {% if paginator.getPaginatedItems %}
        <twig:Table>
            {% block table_content %}
                <tr>
                    <th colspan="7" style="text-align:center;">Diplomatiewertung</th>
                </tr>
                <tr>
                    <th style="width:25px;">#</th>
                    <th>Nick</th>
                    <th>Rasse</th>
                    <th>Allianz</th>
                    <th>Bewertung</th>
                </tr>
                {% for stat in paginator.getPaginatedItems %}
                    {% if stat.user.nick == app.user.data.nick %}
                        {% set addClass = 'userSelfColor' %}
                    {% elseif stat.user.alliance == app.user.data.alliance %}
                        {% set addClass = 'userAllianceMemberColor' %}
                    {% else %}
                        {% set addClass = '' %}
                    {% endif %}
                    <tr>
                        <td class="{{ addClass }}">
                            {{ loop.index }}
                        </td>
                        <td class="{{ addClass }}">
                            <div id="ttuser{{ stat.user.id }}" style="display:none;">
                                <a href="{{ path('game.userinfo',{id:stat.id, popup:1}) }}" onclick="window.open('{{ path('game.userinfo',{id:stat.id, popup:1}) }}','popup','status=no,width=800,height=600,scrollbars=yes');return false;">Profil anzeigen</a> <br>
                                <a href="{{ path('game.stats.userdetail',{id:stat.id, popup:1}) }}" onclick="window.open('{{ path('game.stats.userdetail',{id:stat.id, popup:1}) }}','popup','status=no,width=800,height=600,scrollbars=yes');return false;">Punkteverlauf</a> <br>
                                {% if stat.id != app.user.id %}
                                    <a href="?page=messages&amp;mode=new&amp;message_user_to=11">Nachricht senden</a> <br>
                                    <a href="{{ path('game.buddylist.add',{id:stat.id}) }}">Als Freund hinzufügen</a>
                                {% endif %}
                            </div>
                            <a class="{{ addClass }}" href="#" onclick="showTT('{{ stat.user.nick }}','ttuser{{ stat.user.id }}',0,event,this);return false;">{{ stat.user.nick }}</a>
                        </td>
                        <td class="{{ addClass }}">{{ stat.user.race.name }}</td>
                        <td class="{{ addClass }}">
                            {% if stat.user.alliance %}
                                {{ stat.user.alliance.tag }}
                            {% endif %}
                        </td>
                        <td class="{{ addClass }}">{{ stat.diplomacyRating }}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        </twig:Table>
    {% else %}
        <div>
            <i>Keine Datensätze gefunden!</i>
        </div>
    {% endif %}
{% endblock %}
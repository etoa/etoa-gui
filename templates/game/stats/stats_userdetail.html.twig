{% extends app.request.query.get('popup')
    ? 'layout/base.html.twig'
    : 'layout/game.html.twig' %}

{% set currentContent %}
    <twig:Table title="Statistiken für {{ user.nick }}">
    {% block table_content %}
        <tr>
            <td colspan="6" style="text-align:center;">
                <b>Punkte aktuell:</b>
                {{ formatNumber(user.points) }}, <b>Rang aktuell:</b> {{ user.rank }}
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align:center;">
                <img src="{{ path('images.stats',{id:user.id}) }}" alt="Diagramm" />
            </td>
        </tr>
        {% if pointEntries %}
            <tr>
                <th>Datum</th>
                <th>Zeit</th>
                <th>Punkte</th>
                <th>Flotte</th>
                <th>Forschung</th>
                <th>Gebäude</th>
            </tr>
            {% for entry in pointEntries %}
                <tr>
                    <td>{{ entry.timestamp|date('d.m.Y') }}</td>
                    <td>{{ entry.timestamp|date('H:i') }}</td>
                    <td>{{ formatNumber(entry.points) }}</td>
                    <td>{{ formatNumber(entry.shipPoints) }}</td>
                    <td>{{ formatNumber(entry.techPoints) }}</td>
                    <td>{{ formatNumber(entry.buildingPoints) }}</td>
                </tr>
            {% endfor %}
        {% else %}
            <tr>
                <td colspan="6">
                    <i>Keine Punktedaten vorhanden!</i>
                </td>
            </tr>
        {% endif %}
    {% endblock %}
    </twig:Table>
{% endset %}

{% if app.request.query.get('popup') %}
    {% set bodyTopStuff %}
        {{ currentContent }}
    {% endset %}
{% else %}
    {% set content %}
        {{ currentContent }}
        <input type="button" value="Nachricht senden" onclick="document.location='?page=messages&amp;mode=new&amp;message_user_to= intval(user.id) '" />
        <a href="{{ path('game.stats.userdetail',{id:user.id}) }}">
            <input type="button" value="Statistiken anzeigen"/>
        </a>
    {% endset %}
{% endif %}
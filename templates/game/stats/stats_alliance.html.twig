{% extends 'game/stats/stats.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block stats %}
    {% if stats %}
        <twig:Table title="Allianzen">
            {% block table_content %}
                <tr>
                    <th style="width:50px;">Rang</th>
                    <th>Tag</th>
                    <th>Name</th>
                    <th>
                        Punkte
                        <a href="{{ path('game.stats.alliances', {sort: 'points', order: 'DESC'}) }}" title="Absteigend sortieren">
                            <img src="{{ asset('build/images/s_desc.png') }}" alt="Absteigend sortieren"/>
                        </a>
                        <a href="{{ path('game.stats.alliances', {sort: 'points', order: 'ASC'}) }}" title="Aufsteigend sortieren">
                            <img src="{{ asset('build/images/s_asc.png') }}" alt="Aufsteigend sortieren"/>
                        </a>
                    </th>
                    <th>
                        User-Schnitt
                        <a href="{{ path('game.stats.alliances', {sort: 'userAverage', order: 'DESC'}) }}" title="Absteigend sortieren">
                            <img src="{{ asset('build/images/s_desc.png') }}" alt="Absteigend sortieren"/>
                        </a>
                        <a href="{{ path('game.stats.alliances', {sort: 'userAverage', order: 'ASC'}) }}" title="Aufsteigend sortieren">
                            <img src="{{ asset('build/images/s_asc.png') }}" alt="Aufsteigend sortieren"/>
                        </a>
                    <th>
                        User
                        <a href="{{ path('game.stats.alliances', {sort: 'count', order: 'DESC'}) }}" title="Absteigend sortieren">
                            <img src="{{ asset('build/images/s_desc.png') }}" alt="Absteigend sortieren"/>
                        </a>
                        <a href="{{ path('game.stats.alliances', {sort: 'count', order: 'ASC'}) }}" title="Aufsteigend sortieren">
                            <img src="{{ asset('build/images/s_asc.png') }}" alt="Aufsteigend sortieren"/>
                        </a>
                    </th>
                </tr>
                {% for stat in stats %}
                    {% if stat.alliance == app.user.data.alliance %}
                        {% set addClass = 'userAllianceMemberColor' %}
                    {% else %}
                        {% set addClass = '' %}
                    {% endif %}
                    <tr>
                        <td {{ tm('Punkteverlauf', '<div><img src="'~path('images.alliance.stats',{id:stat.alliance.id})~'" alt="Diagramm" style="width:600px;height:400px;background:#335 url('~asset('/build/images/loading335.gif')~') no-repeat 300px 200px;" /></div>')|raw }} class="{{ addClass }}">
                            {{ loop.index }}
                            {% if stat.currentRank < stat.lastRank %}
                                <img src="{{ asset('build/images/stats/stat_down.gif') }}" alt="down" width="9" height="12"/>
                            {% elseif stat.currentRank > stat.lastRank %}
                                <img src="{{ asset('build/images/stats/stat_up.gif') }}" alt="up" width="9" height="11"/>
                            {% else %}
                                <img src="{{ asset('build/images/stats/stat_same.gif') }}" alt="same" width="21" height="9"/>
                            {% endif %}
                        </td>
                        <td class="{{ addClass }}">{{ stat.allianceTag }}</td>
                        <td class="{{ addClass }}">
                            <div id="ttuser{{ stat.alliance.id }}" style="display:none;">
                                <a href="{{ path('game.alliance.info',{id:stat.alliance.id, popup:1}) }}" onclick="window.open('{{ path('game.alliance.info',{id:stat.alliance.id, popup:1}) }}','popup','status=no,width=800,height=600,scrollbars=yes');return false;">Allianzseite</a> <br>
                                <a href="{{ path('game.stats.alliancedetail',{id:stat.alliance.id, popup:1}) }}" onclick="window.open('{{ path('game.stats.alliancedetail',{id:stat.alliance.id, popup:1}) }}','popup','status=no,width=800,height=600,scrollbars=yes');return false;">Punkteverlauf</a> <br>
                            </div>
                            <a class="{{ addClass }}" href="#" onclick="showTT('{{ stat.allianceName }}','ttuser{{ stat.alliance.id }}',0,event,this);return false;">{{ stat.allianceName }}</a>
                        </td>
                        <td class="{{ addClass }}">{{ formatNumber(stat.points) }}</td>
                        <td class="{{ addClass }}">{{ formatNumber(stat.userAverage) }}</td>
                        <td class="{{ addClass }}">{{ stat.count }}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        </twig:Table>
    {% else %}
        <div>
            <i>Keine Datensätze gefunden!</i>
        </div>
    {% endif %}
{% endblock %}
{% extends 'game/planetoverview/overview.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block overview %}
    <div id="tabShips">
        <twig:Table title="Kampfstärke">
        {% block table_content %}
            {% if planet.shiplist %}
                <tr>
                    <th>
                        <b>Einheit</b>
                    </th>
                    <th>Grundwerte</th>
                    <th>Aktuelle Werte</th>
                </tr>
                <tr>
                    <td><b>Struktur:</b></td>
                    <td>{{ formatNumber(totalStructure) }}</td>
                    <td>
                        {{ formatNumber(totalStructure * structure_tech_a) }}
                        {% if structure_tech_a > 1 %}
                            ({{ formatPercentString(structure_tech_a, true)|raw }} durch {{ structure }}
                            {{ structure_tech_level }})
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td>
                        <b>Schilder:</b>
                    </td>
                    <td>{{ formatNumber(totalShield) }}</td>
                    <td>
                        {{ formatNumber(totalShield * shield_tech_a) }}
                        {% if shield_tech_a > 1 %}
                            ({{ formatPercentString(shield_tech_a, true)|raw }} durch {{ shield }}
                            {{ shield_tech_level }})
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td>
                        <b>Waffen:</b>
                    </td>
                    <td>{{ formatNumber(totalWeapon) }}</td>
                    <td>
                        {{ formatNumber(totalWeapon * weapon_tech_a) }}
                        {% if weapon_tech_a > 1 %}
                            ({{ formatPercentString(weapon_tech_a, true)|raw }} durch {{ weapon }}
                            {{ weapon_tech_level }})
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td>
                        <b>Reparatur:</b>
                    </td>
                    <td>{{ formatNumber(totalHeal) }}</td>
                    <td>
                        {{ formatNumber(totalHeal * heal_tech_a) }}
                        {% if heal_tech_a > 1 %}
                            ({{ formatPercentString(heal_tech_a, true)|raw }} durch {{ regena }}
                            {{ heal_tech_level }})
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td>
                        <b>Anzahl Schiffe:</b>
                    </td>
                    <td colspan="2">{{ formatNumber(defCounts) }}</td>
                </tr>
            {% else %}
                <tr>
                    <td>
                        <i>Keine Schiffe vorhanden!</i>
                    </td>
                </tr>
            {% endif %}
        {% endblock %}
        </twig:Table>
        <twig:Table title="Details">
            {% block table_content %}
                <tr>
                    <th>Typ</th>
                    <th>Anzahl</th>
                    <th>Felder</th>
                </tr>
                {% for defs in planet.deflist %}
                    <tr>
                        <td>{{ defs.defense.name }}</td>
                        <td>{{ defs.count }}</td>
                        <td>{{ defs.count * defs.defense.fields }}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        </twig:Table>
    </div>
{% endblock %}
{% extends 'game/reports/reports.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block reports %}
    {% if msg.success is defined %}
        {{ macros.successMessage(msg.success) }}
    {% endif %}

    {% if form.children.reports.children|length > 0 %}
        {{ form_start(form) }}
            <table class="tb">
                <caption>{{ title }}</caption>
                <tr>
                    <th colspan="5">
                        <div style="float:right;">
                            {% if pagination.getNextPageNumber %}
                                <a href="{{ app.request.pathInfo }}?{{ app.request.query.all|merge({page: pagination.getNextPageNumber})|url_encode }}">
                                    <input type="button" value=">">
                                </a>
                                <a href="{{ app.request.pathInfo }}?{{ app.request.query.all|merge({page: pagination.getLastPageNumber})|url_encode }}">
                                    <input type="button" value=">>">
                                </a>
                            {% endif %}
                            {% if pagination.getPreviousPageNumber %}
                                <a href="{{ app.request.pathInfo }}?{{ app.request.query.all|merge({page: pagination.getFirstPageNumber})|url_encode }}">
                                    <input type="button" value="<<">
                                </a>
                                <a href="{{ app.request.pathInfo }}?{{ app.request.query.all|merge({page: pagination.getPreviousPageNumber})|url_encode }}">
                                    <input type="button" value="<">
                                </a>
                            {%  endif %}
                        </div>
                    </th>
                </tr>
                <tr>
                    <th colspan="2">Nachricht:</th>
                    {% if title == 'Neueste Berichte' %}
                        <th style="width:100px;">Kategorie:</th>
                    {% endif %}
                    <th style="width:150px">Datum:</th>
                    <th style="text-align:center;">
                        <input type="button" value="X" onclick="toggleCheckboxGroup(this, '{{ form.children.reports.vars.full_name }}[')"/>
                    </th>
                </tr>

                {% for report in form.children.reports.children %}
                    <tr>
                        <td class='messageCellIcon' style="width:16px">
                            <img src="{{ report.vars.data.isRead?asset('/build/images/pm_normal.gif'):asset('/build/images/pm_new.gif') }}"/>
                        </td>
                        <td class='messageCellSubject' id="header{{ report.vars.data.id }}">
                            <a href="javascript:" data-report="{{ report.vars.data.id }}" data-read="{{ report.vars.data.isRead }}" class="openReport" onclick="toggleBox('report{{ report.vars.data.id }}')">{{ report.vars.data.createFactory.getSubject }}</a>
                        </td>
                        {% if title == 'Neueste Berichte' %}
                            <td class='messageCellCategory'>
                                <b>{{ report.vars.data.typeName }}</b>
                            </td>
                        {% endif %}
                        <td class='messageCellDate'>{{ formatTimestamp(report.vars.data.timestamp) }}</td>
                        <td class='messageCellAction' id="del{{ report.vars.data.id}}" style="width:2%;text-align:center;padding:0;vertical-align:middle;">
                            {{ form_widget(report.children.deleted) }}
                        </td>
                    </tr>
                    <tr>
                        <td colspan="5" style="padding:10px;display:none;" id="report{{ report.vars.data.id }}">
                            {{ include('components/reports/' ~ report.vars.data.type ~ '/'~report.vars.data.createFactory.subtype~'.html.twig', { report: report.vars.data }) }}
                            <br /><br />
                            {{ form_widget(report.children.deleteReport) }}
                            <twig:ticketbutton cat="8" title="Regelverstoss melden"/>
                        </td>
                    </tr>
                {% endfor %}
            </table>
        {{ form_end(form) }}
    {% else %}
        {{ macros.errorMessage('Keine Berichte vorhanden') }}
    {% endif %}
{% endblock %}
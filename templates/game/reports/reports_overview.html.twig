{% extends 'game/reports/reports.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block reports %}
    {% if msg.success is defined %}
        {{ macros.successMessage(msg.success) }}
    {% endif %}
    {{ form_start(form) }}
        <table class="tb">
            <caption>{{ title }}</caption>
            <tr>
                <th colspan="2">Nachricht:</th>
                {% if title == 'Neueste Berichte' %}
                    <th style="width:100px;">Kategorie:</th>
                {% endif %}
                <th style="width:150px">Datum:</th>
                <th style="text-align:center;">
                    <input type="button" id="selectBtn" value="X" onclick="xajax_reportSelectAll(this.value)"/>
                </th>
            </tr>

            {% for report in paginator.getPaginatedItems %}
                <tr>
                    <td class='messageCellIcon' style="width:16px">
                        <img src="{{ report.isRead?asset('/build/images/pm_normal.gif'):asset('/build/images/pm_new.gif') }}"/>
                    </td>
                    <td class='messageCellSubject' id="header{{ report.id }}">
                        <a href="javascript:;" onclick="toggleBox('report{{ report.id }}')">{{ report.createFactory.getSubject }}</a>
                    </td>
                    {% if title == 'Neueste Berichte' %}
                        <td class='messageCellCategory'>
                            <b>{{ report.typeName }}</b>
                        </td>
                    {% endif %}
                    <td class='messageCellDate'>{{ formatTimestamp(report.timestamp) }}</td>
                    <td class='messageCellAction' id="del{{ report.id}}" style="width:2%;text-align:center;padding:0;vertical-align:middle;">
                        <input id="delreport[cnt]" type="checkbox" name="delreport[rid]" value="1" title="Report zum L&ouml;schen markieren" />
                    </td>
                </tr>
                <tr>
                    <td colspan="5" style="padding:10px;display:none;" id="report{{ report.id }}">
                        {{ include('components/reports/' ~ report.type ~ '/'~report.createFactory.subtype~'.html.twig', { report: report }) }}
                        <br /><br />
                        <input type="button" value="L&ouml;schen" onclick="toggleBox('report rid');xajax_reportSetDeleted( rid);" />&nbsp;
                        <twig:ticketbutton cat="8" title="Regelverstoss melden"/>
                    </td>
                </tr>
            {% endfor %}
        </table>
    {{ form_end(form) }}
{% endblock %}
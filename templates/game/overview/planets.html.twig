<div style="position: relative; left: 0; top: 0; vertical-align: middle;" class="planet_circle_outer_container">
    <div style="position: relative; left: 0; top: 0; text-align: center; vertical-align: middle;" id="planet_circle_inner_container">
        {{ planets|raw }}
        <table style="text-align:center; vertical-align:middle;margin: 0 auto; width: 50%; top: 50%; left: 50%; position: absolute; transform: translate(-50%, -50%);">
            <tr>
                <td colspan="3">&nbsp;</td>
            </tr>
            <tr>
                <td class="PlaniTextCenterPlanetname" id="planet_info_name" colspan="3" style="text-align:center">&nbsp;</td>
            </tr>
            <tr>
                <td colspan="3">&nbsp;</td>
            </tr>
            <tr>
                <td class="PlaniTextCenterBeschreibung">
                    <div id="planet_info_text_building">&nbsp;</div>
                </td>
                <td >&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_building_name">&nbsp;</td>
            </tr>
            <tr>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_building_time">&nbsp;</td></tr>
            <tr>
                <td class="PlaniTextCenterBeschreibung"><div id="planet_info_text_shipyard">&nbsp;</div></td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_shipyard_name">&nbsp;</td>
            </tr>
            <tr>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_shipyard_time">&nbsp;</td>
            </tr>
            <tr>
                <td class="PlaniTextCenterBeschreibung"><div id="planet_info_text_defense">&nbsp;</div></td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_defense_name">&nbsp;</td>
            </tr>
            <tr>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_defense_time">&nbsp;</td>
            </tr>
            <tr>
                <td colspan="3">&nbsp;</td>
            </tr>
            <tr>
                <td colspan="3" class="PlaniTextCenterRessourcen" id="planet_info_text_res">&nbsp;</td>
            </tr>
            <tr>
                <td id="planet_info_text_res_metal" >&nbsp;</td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_res_metal">&nbsp;</td>
            </tr>
            <tr>
                <td id="planet_info_text_res_crystal" >&nbsp;</td>
                <td >&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_res_crystal">&nbsp;</td>
            </tr>
            <tr>
                <td id="planet_info_text_res_plastic" >&nbsp;</td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_res_plastic">&nbsp;</td>
            </tr>
            <tr>
                <td id="planet_info_text_res_fuel" >&nbsp;</td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_res_fuel">&nbsp;</td>
            </tr>
            <tr>
                <td id="planet_info_text_res_food" >&nbsp;</td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_res_food">&nbsp;</td>
            </tr>
            <tr>
                <td id="planet_info_text_people" >&nbsp;</td>
                <td>&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_people">&nbsp;</td>
            </tr>
            <tr>
                <td id="planet_info_text_power" >&nbsp;</td>
                <td >&nbsp;</td>
                <td class="PlaniTextCenter" id="planet_info_power">&nbsp;</td>
            </tr>
        </table>
    </div>
</div>
{% extends 'game/shipyard/shipyard.html.twig' %}

{% block shipyard_content %}
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
    {{ form_start(sortForm) }}
    <twig:Box title="Filter">
        {% block content %}
            <div style="text-align:center;">
                {{ form_widget(sortForm.itemOrderShip) }}
                {{ form_widget(sortForm.itemOrderWay) }}
                {{ form_widget(sortForm.submit) }}
            </div>
        {% endblock %}
    </twig:Box>
    {{ form_end(sortForm) }}

    {# Build Queue #}
    {% if shipyardData.queue is not empty %}
        <table class="tb" style="width:100%">
            <caption>Bauliste</caption>
            {# Current Item #}
            {% if shipyardData.queue.current is defined %}
                <tr>
                    <th colspan="2">Aktuell</th>
                    <th>Start</th>
                    <th>Ende</th>
                    <th colspan="2">Verbleibend</th>
                </tr>
                <tr>
                    <td colspan="2">{{ shipyardData.queue.current.name }}</td>
                    <td>{{ shipyardData.queue.current.startTime|date('d.m.Y H:i') }}</td>
                    <td>{{ shipyardData.queue.current.endTime|date('d.m.Y H:i') }}</td>
                    <td colspan="2">{{ formatTimespan(shipyardData.queue.current.remaining) }}</td>
                </tr>
            {% endif %}

            {# Queue Items #}
            <tr>
                <th style="width:40px;">Anzahl</th>
                <th style='width:100%'>Bauauftrag</th>
                <th>Start</th>
                <th>Ende</th>
                <th>Verbleibend</th>
                <th>Aktionen</th>
            </tr>
            {% for item in shipyardData.queue.items %}
                <tr>
                    <td>{{ item.count }}</td>
                    <td>{{ item.name }}</td>
                    <td style='white-space: nowrap;'>{{ item.startTime|date('d.m.Y H:i') }}</td>
                    <td style='white-space: nowrap;'>{{ item.endTime|date('d.m.Y H:i') }}</td>
                    <td style='white-space: nowrap;'>{{ formatTimespan(item.remaining) }}</td>
                    <td>
                        {% if item.cancelable %}
                            <a href="{{ path('game.shipyard.cancel',{id:item.id}) }}"
                               onclick="return confirm('Soll dieser Auftrag wirklich abgebrochen werden?');">Abbrechen</a>
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    {# Ship Categories #}
    {% if shipyardData.hasShips %}
        {{ form_start(shipForm) }}
            {% for category in shipyardData.categories %}
                <table style="width:100%" class="tb shipCategory {{ shipyardData.compactView ? 'compact' : '' }}">
                    <caption>{{ category.name }}</caption>

                    {% if shipyardData.compactView %}
                        {# Compact View Header #}
                        <tr>
                            <th colspan="2" class="tbltitle">Schiff</th>
                            <th class="tbltitle">Zeit</th>
                            <th class="tbltitle">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::METAL') }}</th>
                            <th class="tbltitle">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::CRYSTAL') }}</th>
                            <th class="tbltitle">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::PLASTIC') }}</th>
                            <th class="tbltitle">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::FUEL') }}</th>
                            <th class="tbltitle">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::FOOD') }}</th>
                            <th class="tbltitle">Anzahl</th>
                        </tr>

                        {# Compact View Ships #}
                        {% for ship in category.ships %}
                            <tr>
                                <td class='shipCellImage'>
                                    {% if ship.special %}
                                        <img class='shipImageSmall' src="{{ ship.image }}"/>
                                    {% else %}
                                        <a href="{{ path(game.help.shipyard.detail,{id:ship.id}) }}"><img src="{{ ship.image }}"
                                                                                       class='shipImageSmall'/></a>
                                    {% endif %}
                                </td>
                                <th class='shipCellName'>
                                    <span style="font-weight:500">{{ ship.name }}<br/>
                                    Gebaut:</span> {{ ship.shipCount|number_format }}
                                </th>
                                <td width="13%">{{ formatTimespan(ship.buildTime) }}</td>
                                <td width="10%"
                                    {% if ship.costs.metal > ship.available.metal %}style="color:red;"{% endif %}>{{ ship.costs.metal|number_format }}</td>
                                <td width="10%"
                                    {% if ship.costs.crystal > ship.available.crystal %}style="color:red;"{% endif %}>{{ ship.costs.crystal|number_format }}</td>
                                <td width="10%"
                                    {% if ship.costs.plastic > ship.available.plastic %}style="color:red;"{% endif %}>{{ ship.costs.plastic|number_format }}</td>
                                <td width="10%"
                                    {% if ship.costs.fuel > ship.available.fuel %}style="color:red;"{% endif %}>{{ ship.costs.fuel|number_format }}</td>
                                <td width="10%"
                                    {% if ship.costs.food > ship.available.food %}style="color:red;"{% endif %}>{{ ship.costs.food|number_format }}</td>
                                <td>
                                    {% if ship.shipCount >= ship.maxCount and ship.maxCount != 0 %}
                                        Max
                                    {% else %}
                                        {% if ship.maxBuildable > 0 %}
                                            {% set attr = {
                                                'onmouseover': 'showTT("","Es können maximal '~ship.maxBuildable~' Schiffe gebaut werden",1,event,this);'
                                            }%}
                                        {% else %}
                                            {% set attr = {
                                                'onmouseover': 'showTT("","Rohstoffe verfügbar in '~formatTimespan(max(ship.waitTimes))~'",1,event,this);'
                                            }%}
                                        {% endif %}
                                        {{ form_widget(shipForm[ship.id],{'attr': attr}) }} Stück
                                        <br><a href="javascript:;"
                                               onclick="document.getElementById('build_count_{{ ship.id }}').value={{ ship.maxBuildable }};">max</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        {# Full View Ships #}
                        {% for ship in category.ships %}
                            <tr class='shipRowName'>
                                <th colspan="5" height="20">{{ ship.name }}</th>
                            </tr>
                            <tr>
                                <td class='shipCellImage' height="120" rowspan="3">
                                    {% if ship.model %}
                                        <model-viewer src="{{ asset(ship.model) }}" ar shadow-intensity="1" camera-controls touch-action="pan-y"></model-viewer>
                                    {% else %}
                                        {% if ship.special %}
                                            <img src="{{ ship.imageMedium }}" width="120" height="120"/>
                                        {% else %}
                                            <a href="{{ path('game.help.shipyard.detail',{id:ship.id}) }}"
                                               title="Info zu diesem Schiff anzeigen">
                                                <img src="{{ ship.imageMedium }}" width="120" height="120"/>
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                </td>
                                <td class='shipCellDescription' colspan="4" valign="top">{{ ship.shortComment }}</td>
                            </tr>
                            <tr>
                                <th height="30">Vorhanden:</th>
                                <td colspan="3">{{ ship.shipCount|number_format }}</td>
                            </tr>
                            <tr>
                                <th height="30">Bauzeit</th>
                                <td>{{ formatTimespan(ship.buildTime) }}</td>
                                {% if ship.shipCount >= ship.maxCount and ship.maxCount != 0 %}
                                    <th height="30" colspan="2"><i>Maximalanzahl erreicht</i></th>
                                {% else %}
                                    <th height="30">In Auftrag geben:</th>
                                    <td>
                                        {% if ship.maxBuildable > 0 %}
                                            {% set attr = {
                                                'onmouseover': 'showTT("","Es können maximal '~ship.maxBuildable~' Schiffe gebaut werden",1,event,this);'
                                            }%}
                                        {% else %}
                                            {% set attr = {
                                                'onmouseover': 'showTT("","Rohstoffe verfügbar in '~formatTimespan(max(ship.waitTimes))~'",1,event,this);'
                                            }%}
                                        {% endif %}
                                        {{ form_widget(shipForm[ship.id],{'attr': attr}) }} Stück
                                        <br><a href="javascript:;"
                                               onclick="document.getElementById('ship_form_{{ ship.id }}').value={{ ship.maxBuildable }};">max</a>
                                        {% if not ship.hasQueue %}
                                            &nbsp;<a href="javascript:this.preventDefault();"
                                                     onclick="if(document.getElementById('changePeople').style.display==='none') {toggleBox('changePeople')};updatePeopleWorkingBox('{{ ship.peopleOptimized }}','-1','^-1');">optimieren</a>
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                            <tr>
                                <th height="20"
                                    width="110">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::METAL') }}:
                                </th>
                                <th height="20"
                                    width="97">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::CRYSTAL') }}:
                                </th>
                                <th height="20"
                                    width="98">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::PLASTIC') }}:
                                </th>
                                <th height="20"
                                    width="97">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::FUEL') }}:
                                </th>
                                <th height="20"
                                    width="98">{{ constant('EtoA\\Universe\\Resources\\ResourceNames::FOOD') }}</th>
                            </tr>
                            <tr>
                                <td height="20" width="110"
                                        {% if ship.costs.metal > ship.available.metal %}
                                            style="color:red;"
                                            {{ tm("Fehlender Rohstoff",formatNumber(
                                                ship.costs.metal - ship.available.metal)~' '~constant('EtoA\\Universe\\Resources\\ResourceNames::METAL')~'<br />Bereit in '~formatTimespan(ship.waitTimes.metal)
                                            )|raw }}
                                        {% endif %}
                                >
                                    {{ ship.costs.metal|number_format }}
                                </td>
                                <td height="20" width="25%"
                                        {% if ship.costs.crystal > ship.available.crystal %}
                                            style="color:red;"
                                            {{ tm("Fehlender Rohstoff",formatNumber(
                                                ship.costs.crystal - ship.available.crystal)~' '~constant('EtoA\\Universe\\Resources\\ResourceNames::CRYSTAL')~'<br />Bereit in '~formatTimespan(ship.waitTimes.crystal)
                                            )|raw }}
                                        {% endif %}
                                >
                                    {{ ship.costs.crystal|number_format }}
                                </td>
                                <td height="20" width="25%"
                                        {% if ship.costs.plastic > ship.available.plastic %}
                                            style="color:red;"
                                            {{ tm("Fehlender Rohstoff",formatNumber(
                                                ship.costs.plastic - ship.available.plastic)~' '~constant('EtoA\\Universe\\Resources\\ResourceNames::PLASTIC')~'<br />Bereit in '~formatTimespan(ship.waitTimes.plastic)
                                            )|raw }}
                                        {% endif %}
                                >
                                    {{ ship.costs.plastic|number_format }}
                                </td>
                                <td height="20" width="25%"
                                        {% if ship.costs.fuel > ship.available.fuel %}
                                            style="color:red;"
                                            {{ tm("Fehlender Rohstoff",formatNumber(
                                                ship.costs.fuel - ship.available.fuel)~' '~constant('EtoA\\Universe\\Resources\\ResourceNames::FUEL')~'<br />Bereit in '~formatTimespan(ship.waitTimes.fuel)
                                            )|raw }}
                                        {% endif %}
                                >
                                    {{ ship.costs.fuel|number_format }}
                                </td>
                                <td height="20" width="25%"
                                        {% if ship.costs.food > ship.available.food %}
                                            style="color:red;"
                                            {{ tm("Fehlender Rohstoff",formatNumber(
                                                ship.costs.food - ship.available.food)~' '~constant('EtoA\\Universe\\Resources\\ResourceNames::FOOD')~'<br />Bereit in '~formatTimespan(ship.waitTimes.food)
                                            )|raw }}
                                        {% endif %}
                                >
                                    {{ ship.costs.food|number_format }}
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </table>
            {% endfor %}

            {% if shipyardData.categories|length > 0 %}
                {{ form_widget(shipForm.submit) }}<br/><br/>
            {% endif %}
            {{ form_widget(shipForm._token) }}
            {{ form_widget(shipForm.checker) }}
        {{ form_end(shipForm,{render_rest:false}) }}
    {% else %}
        <p>Es können noch keine Schiffe gebaut werden! Baue zuerst die benötigten Gebäude und erforsche die
            erforderlichen Technologien!</p>
    {% endif %}
{% endblock %}
{% if this.report.deleted %}
    {% set style = 'style="color:#f90"' %}
{% elseif (not this.report.read) %}
    {% set style = 'style="color:#0f0"' %}
{% elseif (this.report.archived) %}
    {% set style = 'style="font-style:italic"' %}
{% else %}
    {% set style = '' %}
{% endif %}

<tbody
    {{ attributes }}
    data-original-data="{}" {# Hack to prevent issue with symfony/ux #}
>
<tr
    data-controller="toggle"
    {{ style|raw }}
>
    <td>{{ formatTimestamp(this.report.timestamp) }}</td>
    <td>{{ this.report.type }}</td>
    <td>{{ this.report.user.nick }}</td>
    <td>{{ this.report.subject }}</td>

    <td>
        <a href="#report-{{ this.report.id }}" data-action="click->toggle#onClick">Details</a>
        {% if this.report.deleted %}
            <a href="#report-{{ this.report.id }}" data-action="live#action" data-live-action-param="prevent|undelete">Wiederherstellen</a>
        {% else %}
            <a href="#report-{{ this.report.id }}" data-action="live#action" data-live-action-param="prevent|delete">Löschen</a>
        {% endif %}
    </td>
</tr>
<tr id="report-{{ this.report.id }}" data-toggle-target="target" class="hide">
    <td colspan="99">
        {% include 'components/reports/' ~ this.report.type ~ '/' ~ this.report.createFactory.subtype ~ '.html.twig' %}
    </td>
</tr>
</tbody>

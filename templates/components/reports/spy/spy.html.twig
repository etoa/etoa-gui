{% import 'components/reports/macros.html.twig' as macros %}

<strong>Planet:</strong> {{ macros.entity(report.entity1) }}<br />
<strong>Besitzer:</strong> {{ macros.user(report.opponent1) }}<br />

{% if report.spyReportData.buildings %}
    <br /><strong>GEBÄUDE:</strong><br />
    {% if report.spyReportData.buildings %}
        {{ macros.dataTable(report.spyReportData.buildings) }}
    {% else %}
        <i>Nichts vorhanden!</i><br />
    {% endif %}
{% endif %}

{% if report.spyReportData.showTechnologies %}
    <br /><strong>TECHNOLOGIEN:</strong><br />
    {% if report.spyReportData.technologies %}
        {{ macros.dataTable(report.spyReportData.technologies) }}
    {% else %}
        <i>Nichts vorhanden!</i><br />
    {% endif %}
{% endif %}

{% if report.spyReportData.showShips %}
    <br /><strong>SCHIFFE:</strong><br />
    {% if report.spyReportData.ships %}
        {{ macros.dataTable(report.spyReportData.ships) }}
    {% else %}
        <i>Nichts vorhanden!</i><br />
    {% endif %}
{% endif %}


{% if report.spyReportData.showDefense %}
    <br /><strong>VERTEIDIGUNG:</strong><br />
    {% if report.spyReportData.defense %}
        {{ macros.dataTable(report.spyReportData.defense) }}
    {% else %}
        <i>Nichts vorhanden!</i><br />
    {% endif %}
{% endif %}

{% if report.spyReportData.resources.sum > 0 %}
    <br /><strong>ROHSTOFFE:</strong><br />
    {{ macros.resourceTable(report.spyReportData.resources) }}
{% endif %}

<br /><strong>Spionageabwehr:</strong> {{ report.spyReportData.spyDefense }}%<br />
<strong>Tarnung:</strong> {{ report.spyReportData.coverage }}%

{% import 'components/reports/macros.html.twig' as macros %}

<strong>KAMPFBERICHT</strong><br/>
vom Planeten {{ macros.entity(report.entity1) }}<br/>
<strong>Zeit:</strong> {{ formatTimestamp(report.timestamp) }}<br/><br/>
<table class="battleTable">
    <tr>
        <td>
            <strong>Angreifer:</strong>{{ macros.userList(report.battleReportData.users) }}
        </td>
        <td>
            <strong>Verteidiger:</strong>{{ macros.userList(report.battleReportData.entityUsers) }}
        </td>
    </tr>
    <tr>
        <td>
            <strong>ANGREIFENDE FLOTTE</strong><br/>
            {% if report.battleReportData.ships %}
                {{ macros.dataTable(report.battleReportData.ships) }}
            {% else %}
                <i>Nichts vorhanden!</i>
            {% endif %}
        </td>
        <td>
            <strong>VERTEIDIGENDE FLOTTE</strong><br/>
            {% if report.battleReportData.entityShips %}
                {{ macros.dataTable(report.battleReportData.entityShips) }}
            {% else %}
                <i>Nichts vorhanden!</i>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td>
        </td>
        <td>
            <strong>PLANETARE VERTEIDIGUNG</strong><br/>
            {% if report.battleReportData.entityDefense %}
                {{ macros.dataTable(report.battleReportData.entityDefense) }}
            {% else %}
                <i>Nichts vorhanden!</i>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td>
            <strong>DATEN DES ANGREIFERS</strong><br/>
            <table>
                <tr>
                    <td>Schild ({{ report.battleReportData.shieldTech }}%):</td>
                    <td style="text-align:right;"> {{ formatNumber(report.battleReportData.shield) }}</td>
                </tr>
                <tr>
                    <td>Struktur ({{ report.battleReportData.structureTech }}%):</td>
                    <td style="text-align:right;"> {{ formatNumber(report.battleReportData.structure) }}</td>
                </tr>
                <tr>
                    <td>Waffen ({{ report.battleReportData.weaponTech }}%):</td>
                    <td style="text-align:right;"> {{ formatNumber(report.battleReportData.weapon1) }}</td>
                </tr>
                <tr>
                    <td>Einheiten:</td>
                    <td style="text-align:right;"> {{ formatNumber(report.battleReportData.count1) }}</td>
                </tr>
            </table>
        </td>
        <td>
            <strong>DATEN DES VERTEIDIGERS</strong><br/>
            <table>
                <tr>
                    <td>Schild ({{ report.battleReportData.entityShieldTech }}%):</td>
                    <td style="text-align:right;"> {{ formatNumber(report.battleReportData.entityShield) }}</td>
                </tr>
                <tr>
                    <td>Struktur ({{ report.battleReportData.entityStructureTech }}%):</td>
                    <td style="text-align:right;"> {{ formatNumber(report.battleReportData.entityStructure) }}</td>
                </tr>
                <tr>
                    <td>Waffen ({{ report.battleReportData.entityWeaponTech }}%):</td>
                    <td style="text-align:right;"> {{ formatNumber(report.battleReportData.entityWeapon1) }}</td>
                </tr>
                <tr>
                    <td>Einheiten:</td>
                    <td style="text-align:right;"> {{ report.battleReportData.entityCount1 }}</td>
                </tr>
            </table>
            <br/>
        </td>
    </tr>
    <tr>
        <td colspan="2">
            {% set initShieldStructure = report.battleReportData.shield + report.battleReportData.structure %}
            {% set shieldStructure = initShieldStructure %}
            {% set entityInitShieldStructure = report.battleReportData.entityShield + report.battleReportData.entityStructure %}
            {% set entityShieldStructure = entityInitShieldStructure %}
            {% set maxRound = 1 %}
            {% for round in range(1, 5) %}
                {% if report.battleReportData.count[round] > 0 and report.battleReportData.entityCount[round] > 0 %}
                    {% set maxRound = round %}

                    {% set shieldStructure = max(0, shieldStructure - report.battleReportData.entityWeapon[round]) %}
                    {% set entityShieldStructure = max(0, entityShieldStructure - report.battleReportData.weapon[round]) %}

                    <br/>{{ formatNumber(report.battleReportData.count[round]) }} Einheiten des Angreifers schiessen mit einer Stärke von {{ formatNumber(report.battleReportData.weapon[round]) }} auf den Verteidiger. Der Verteidiger hat danach noch {{ formatNumber(entityShieldStructure) }} Struktur- und Schildpunkte.
                    <br/><br/>
                    {{ formatNumber(report.battleReportData.entityCount[round]) }} Einheiten des Verteidigers schiessen mit einer Stärke von {{ formatNumber(report.battleReportData.entityWeapon[round]) }} auf den Angreifer. Der Angreifer hat danach noch {{ formatNumber(shieldStructure) }} Struktur- und Schildpunkte.
                    <br/><br/>

                    {% if report.battleReportData.heal[round] > 0 and shieldStructure < initShieldStructure %}
                        {% set shieldStructure = min(initShieldStructure, (shieldStructure + report.data.heal[round])) %}
                        Die Einheiten des Angreifers heilen {{ formatNumber(report.battleReportData.heal[round]) }} Struktur- und Schildpunkte. Der Angreifer hat danach wieder {{ formatNumber(shieldStructure) }} Struktur- und Schildpunkte
                        <br/><br/>
                    {% endif %}

                    {% if report.battleReportData.entityHeal[round] > 0 and entityShieldStructure < entityInitShieldStructure %}
                        {% set entityShieldStructure = min(entityInitShieldStructure, (entityShieldStructure + report.battleReportData.entityHeal[round])) %}
                        Die Einheiten des Verteidigers heilen {{ formatNumber(report.battleReportData.entityHeal[round]) }} Struktur- und Schildpunkte. Der Verteidiger hat danach wieder {{ formatNumber(entityShieldStructure) }} Struktur- und Schildpunkte
                        <br/><br/>
                    {% endif %}
                {% endif %}
            {% endfor %}

            Der Kampf dauerte {{ maxRound }} Runden!<br/><br/>
            {% if report.battleReportData.result == 1 %}
                Der Angreifer hat den Kampf gewonnen!
            {% elseif report.battleReportData.result == 2 %}
                Der Verteidiger hat den Kampf gewonnen!
            {% elseif report.battleReportData.result == 3 %}
                Der Kampf endete unentschieden, da sowohl die Einheiten des Angreifers als auch die Einheiten des Verteidigers alle zerstört wurden!
            {% else %}
                Der Kampf endete unentschieden und die Flotten zogen sich zurück!
            {% endif %}
            <br/><br/>
        </td>
    </tr>
    <tr>
        <td>
            <strong>BEUTE</strong><br/>
            {% if report.battleReportData.result == 1 %}
                {{ macros.resourceTable(report.battleReportData.resources) }}
            {% endif %}
            <br/><br/>
        </td>
        <td>
            <strong>TRÜMMERFELD</strong><br/>
            <table>
                {% for i in range(0, 2) %}
                    <tr>
                        <td>{{ report.createFactory.context.resourceNames[i] }}</td>
                        <td style="text-align:right;"> {{ formatNumber(report.battleReportData.wf.get(i)) }}</td>
                    </tr>
                {% endfor %}
            </table>
            <br/>
            <br/><br/>
        </td>
    </tr>
    <tr>
        <td colspan="2">
            Zustand nach dem Kampf:<br/><br/>
        </td>
    </tr>
    <tr>
        <td>
            <strong>ANGREIFENDE FLOTTE</strong><br/>
            {% if report.battleReportData.shipsEnd %}
                {{ macros.dataTable(report.battleReportData.shipsEnd) }}
            {% else %}
                <i>Nichts vorhanden!</i>
            {% endif %}
        </td>
        <td>
            <strong>VERTEIDIGENDE FLOTTE</strong><br/>
            {% if report.battleReportData.entityShipsEnd %}
                {{ macros.dataTable(report.battleReportData.entityShipsEnd) }}
                {{ report.battleReportData.restoreCivilShips }}% der zivilen Schiffe werden wiederhergestellt!
            {% else %}
                <i>Nichts vorhanden!</i>
            {% endif %}
            <br/>
        </td>
    </tr>
    {% if report.battleReportData.exp > 0 or report.battleReportData.entityExp > 0 %}
        <tr>
            <td>
                {% if report.battleReportData.exp > 0 %}
                    Gewonnene EXP: {{ formatNumber(report.battleReportData.exp) }}
                {% endif %}
            </td>
            <td>
                {% if report.battleReportData.entityExp > 0 %}
                    Gewonnene EXP: {{ formatNumber(report.battleReportData.entityExp) }}
                {% endif %}
                <br/><br/>
            </td>
        </tr>
    {% endif %}
    <tr>
        <td>
        </td>
        <td>
            <strong>PLANETARE VERTEIDIGUNG:</strong><br/>
            {% if report.battleReportData.entityDefenseEnd %}
                {{ macros.dataTable(report.battleReportData.entityDefenseEnd) }}
                {{ report.battleReportData.restore }}% der Verteidigungsanlagen werden repariert!
            {% else %}
                <i>Nichts vorhanden!</i>
            {% endif %}
            <br/>
        </td>
    </tr>
</table>

<div {{ attributes }}>
    {{ form_start(this.form, {'attr': {'id': 'ress_selector'}}) }}
        {{ form_widget(this.form.ress_last_update,{id:'ress_last_update'}) }}
        {{ form_widget(this.form.ress_metal,{id:'res_metal'}) }}
        {{ form_widget(this.form.ress_crystal,{id:'res_crystal'}) }}
        {{ form_widget(this.form.ress_plastic,{id:'res_plastic'}) }}
        {{ form_widget(this.form.ress_fuel,{id:'res_fuel'}) }}
        {{ form_widget(this.form.ress_food,{id:'res_food'}) }}

        <twig:Table title="Rohstoffe verkaufen">
            {% block table_content %}
                <tr>
                    <th style="width:15%;vertical-align:middle;">Rohstoff</th>
                    <th style="width:10%;vertical-align:middle;">Angebot</th>
                    <th style="width:5%;text-align:center;vertical-align:middle;">Kurs</th>
                    <th style="width:10%;vertical-align:middle;">Preis</th>
                    <th style="width:40%;vertical-align:middle;">Min./Max.</th>
                </tr>
                <tr>
                    <th style="vertical-align:middle;"> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::METAL') }} :</th>
                    <td style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.sell0,{id:'ress_sell_metal'}) }}
                    </td>
                    <th style="text-align:center;vertical-align:middle;"> {{ runtimeValue('market_rate_0',1)}} </th>
                    <td id="ress_buy_metal_field" style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.buy0,{id:'ress_buy_metal'}) }}
                    </td>
                    <th id="ress_min_max_metal" style="vertical-align:middle;"> - </th>
                </tr>
                <tr>
                    <th style="vertical-align:middle;"> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::CRYSTAL') }} :</th>
                    <td style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.sell1,{id:'ress_sell_crystal'}) }}
                    </td>
                    <th style="text-align:center;vertical-align:middle;"> {{ runtimeValue('market_rate_1',1)}} </th>
                    <td id="ress_buy_crystal_field" style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.buy1,{id:'ress_buy_crystal'}) }}
                    </td>
                    <th id="ress_min_max_crystal" style="vertical-align:middle;"> - </th>
                </tr>
                <tr>
                    <th style="vertical-align:middle;"> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::PLASTIC') }} :</th>
                    <td style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.sell2,{id:'ress_sell_plastic'}) }}
                    </td>
                    <th style="text-align:center;vertical-align:middle;"> {{ runtimeValue('market_rate_2',1)}} </th>
                    <td id="ress_buy_plastic_field" style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.buy2,{id:'ress_buy_plastic'}) }}
                    </td>
                    <th id="ress_min_max_plastic" style="vertical-align:middle;"> - </th>
                </tr>
                <tr>
                    <th style="vertical-align:middle;"> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::FUEL') }} :</th>
                    <td style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.sell3,{id:'ress_sell_fuel'}) }}
                    </td>
                    <th style="text-align:center;vertical-align:middle;"> {{ runtimeValue('market_rate_3',1)}} </th>
                    <td id="ress_buy_fuel_field" style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.buy3,{id:'ress_buy_fuel'}) }}
                    </td>
                    <th id="ress_min_max_fuel" style="vertical-align:middle;"> - </th>
                </tr>
                <tr>
                    <th style="vertical-align:middle;"> {{ constant('EtoA\\Universe\\Resources\\ResourceNames::FOOD') }} :</th>
                    <td style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.sell4,{id:'ress_sell_food'}) }}
                    </td>
                    <th style="text-align:center;vertical-align:middle;"> {{ runtimeValue('market_rate_4',1)}} </th>
                    <td id="ress_buy_food_field" style="vertical-align:middle;">
                        {{ form_widget(outerScope.this.form.buy4,{id:'ress_buy_food'}) }}
                    </td>
                    <th id="ress_min_max_food" style="vertical-align:middle;"> - </th>
                </tr>
                <tr>
                    <th>Beschreibung</th>
                    <td colspan="4">
                        {{ form_widget(outerScope.this.form.text, {
                            'attr': {
                                'data-tooltip': 'Schreib einen kleinen Werbetext für deine Waren.',
                                'data-tooltip-title': 'Text'
                            },
                            id:'ressource_text'
                        }) }}
                    </td>
                </tr>
            <tr>
                <th>Reservation</th>
                <td colspan="3">
                    {% for choice in outerScope.this.form.ressource_offer_reservation %}
                        <div>
                            {{ form_widget(choice, {
                                'attr': {
                                    'id': 'resource_offer_reservation_' ~ loop.index0
                                }
                            }) }}
                            {{ form_label(choice, null, {
                                'label_attr': {
                                    'for': 'resource_offer_reservation_' ~ loop.index0,
                                    'data-tooltip': choice.vars.value == '2' ? 'Fall dieses Angebot nur Spieler aus deiner Allianz kaufen sollen, mach hier ein Häkchen' : null,
                                    'data-tooltip-title': choice.vars.value == '2' ? 'Reservation' : null
                                }
                            }) }}
                        </div>
                    {% endfor %}
                </td>
                <td style="vertical-align:middle">
                    {{ component('UserNickSearch', {
                        boxId: "citybox",
                        field: form_widget(outerScope.this.form.forUser,{id:'resource_offer_user_nick'})
                    }) }}
                    <br/>
                    <div class="citybox" id="citybox">&nbsp;</div></td>
                </tr>
                <tr>
                    <td colspan="5" id="check_message" style="text-align:center;vertical-align:middle;height:30px;">&nbsp;</td>
                </tr>
            {% endblock %}
        </twig:Table>
        {{ form_widget(this.form.submit,{id:'ressource_sell_submit'}) }}
    {{ form_widget(this.form.checker) }}
    {{ form_end(this.form) }}
    <script>
        $(function() {
            $('#resource_offer_user_nick').hide();
            $('input[name="sell_ress[ressource_offer_reservation]"]').click(function() {
                if ($(this).val() === '1') {
                    $('#resource_offer_user_nick').show();
                } else {
                    $('#resource_offer_user_nick').hide();
                }
            });
        });
    </script>
</div>


<tbody
    {{ attributes }}
>
{% if this.item %}
    <tr>
        <td>{{ this.item.id }}</td>
        <td>{{ this.item.user?this.item.user.nick:'Niemand' }}</td>
        <td>{{ this.item.entity.entity.toString }}</td>
        <td>{{ this.item.building.name }}</td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.currentLevel) }}</form>
            {% else %}
                {{ formatNumber(this.item.currentLevel) }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.buildType) }}</form>
            {% else %}
                {{ this.buildTypes[this.item.buildType] }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.startTime) }}</form>
            {% else %}
                {{ this.item.isUnderConstruction() ? formatTimestamp(this.item.startTime) : '-' }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.endTime) }}</form>
            {% else %}
                {{ this.item.isUnderConstruction() ? formatTimestamp(this.item.endTime) : '-' }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <a href="#building-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="submit">Speichern</a>
                <a href="#building-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="abortEdit">Abbrechen</a>
            {% else %}
                <a href="#building-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="showEdit">Bearbeiten</a>
                <a onclick="confirm('Soll {{ this.item.building.name }} {{ this.item.currentLevel}} von diesem Planeten gelöscht werden?')" href="#building-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="delete">Löschen</a>
            {% endif %}
        </td>
    </tr>
{% endif %}
</tbody>

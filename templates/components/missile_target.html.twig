{% import 'macros.html.twig' as macros %}

<div {{ attributes }}>
    {{ form_start(form) }}
        <twig:Table title="Raketen starten">
            {% block table_content %}

                <tr>
                    <th style="width:260px;">Raketen wählen</th>
                    <th colspan="2" style="width:440px;">Ziel wählen</th>
                </tr>
                <tr>
                    <td rowspan="6">
                        {% for missile in outerScope.missilelist %}
                            {% if missile.missile.launchable and missile.count > 0 %}
                                {{ form_widget(form[missile.id]) }}
                                {{ missile.missile.name }} ({{ missile.count }} vorhanden)
                                <br>
                            {% endif %}
                        {% else %}
                            Momentan befinden sich keine startbaren Raketen in deinem Silo!
                        {% endfor %}
                    </td>
                    <th>:</th>
                    <td>
                        {{ form_widget(outerScope.form.csx) }}&nbsp;/&nbsp;
                        {{ form_widget(outerScope.form.csy) }}&nbsp;&nbsp;:&nbsp;&nbsp;
                        {{ form_widget(outerScope.form.ccx) }}&nbsp;/&nbsp;
                        {{ form_widget(outerScope.form.ccy) }}&nbsp;&nbsp;:&nbsp;&nbsp;
                        {{ form_widget(form.psp) }}
                    </td>
                </tr>

                <tr>
                    <th>Favorit wählen:</th>
                    <td>
                        {{ form_widget(outerScope.form.bookmark) }}
                    </td>
                </tr>

                <tr>
                    <th>Zielinfo:</th>
                    <td id="targetinfo" {% if color['targetinfo'] is defined %} style="color:{{ color['targetinfo'] }}" {% endif %}>
                        {{ outerScope.this.info|raw }}
                    </td>
                </tr>
                <tr>
                    <th>Entfernung:</th>
                    <td id="distance" {% if color['distance'] is defined %} style="color:{{ color['distance'] }}" {% endif %}>
                        {{ outerScope.this.distance }}
                    </td>
                </tr>
                <tr>
                    <th>Geschwindigkeit:</th>
                    <td id="speed" {% if color['speed'] is defined %} style="color:{{ color['speed'] }}" {% endif %}>
                        {{ outerScope.this.speed }}
                    </td>
                </tr>
                <tr>
                    <th>Zeit:</th>
                    <td id="time">
                        {{ outerScope.this.duration }}
                    </td>
                </tr>
            {% endblock %}
        </twig:Table>
        {% if this.launchable %}
            {{ form_widget(form.launch) }}
        {% endif %}
        {{ form_widget(form._token) }}
        {{ form_end(form, {render_rest:false}) }}
</div>

{% extends 'components/base_search.html.twig' %}
{% block data %}
    <tr>
        <th style="width:140px;">Datum</th>
        <th>Schweregrad</th>
        <th>Facility</th>
        <th>Besitzer</th>
        <th>Aktion</th>
        <th>Start</th>
        <th>Ziel</th>
        <th>Startzeit</th>
        <th>Landezeit</th>
        <th>Flotte</th>
    </tr>
    {% for log in search.entries %}
        <tbody data-controller="toggle">
            <tr>
                <td>{{ formatTimestamp(log.timestamp) }}</td>
                <td>{{ this.severities[log.severity] }}</td>
                <td>{{ this.facilities[log.facility] }}</td>

                <td>{{ log.user.nick }}</td>
                <td>{{ this.fleetActions[log.action]|raw }} [{{ this.fleetStatusCode[log.status] }}]</td>
                <td>{{ log.entityFrom.toString }} <br/> {{ log.entityFrom.user.nick|default('Niemand') }}</td>
                <td>{{ log.entityTo.toString }} <br/> {{ log.entityTo.user.nick|default('Niemand') }}</td>
                <td>{{ formatTimestamp(log.launchTime) }}</td>
                <td>{{ formatTimestamp(log.landTime) }}</td>
                <td><a href="#log-{{ log.id }}" data-action="click->toggle#onClick">Bericht</a></td>
            </tr>
            <tr id="log-{{ log.id }}" data-toggle-target="target" class="hide">
                <td colspan="10">
                    <table>
                        <tr>
                            <th>Schiffe in der Flotte</th>
                            <th>Vor der Aktion</th>
                            <th>Nach der Aktion</th>
                        </tr>
                        {% for ship in log.fleetShipsStart %}
                            <tr>
                                <td>{{ ship.data.name }}</td>
                                <td>{{ formatNumber(ship.count) }}</td>
                                <td>{{ log.fleetShipsEnd[loop.index0].count }}</td>
                            </tr>
                        {% endfor %}
                    </table>

                    <table>
                        <tr>
                            <th>Schiffe in dem Planeten</th>
                            <th>Vor der Aktion</th>
                            <th>Nach der Aktion</th>
                        </tr>
                        {% for ship in log.entityShipsStart %}
                            <tr>
                                <td>{{ ship.data.name }}</td>
                                <td>{{ formatNumber(ship.count) }}</td>
                                <td>{{ formatNumber(log.entityShipsEnd[loop.index0].count) }}</td>
                            </tr>
                        {% endfor %}
                    </table>

                    <table>
                        <tr>
                            <th>Rohstoffe in der Flotte</th>
                            <th>Vor der Aktion</th>
                            <th>Nach der Aktion</th>
                        </tr>
                        {% for resName,res in log.fleetResStart %}
                            <tr>
                                <td>{{ resName }}</td>
                                <td>{{ formatNumber(res) }}</td>
                                <td>{{ formatNumber(log.fleetResEnd[resName]) }}</td>
                            </tr>
                        {% endfor %}
                    </table>

                    {% if log.entityResStart and log.entityResEnd %}
                        <table>
                            <tr>
                                <th>Rohstoffe auf der Entity</th>
                                <th>Vor der Aktion</th>
                                <th>Nach der Aktion</th>
                            </tr>
                            {% for resName,res in log.entityResStart %}
                                <tr>
                                    <td>{{ resName }}</td>
                                    <td>{{ formatNumber(res) }}</td>
                                    <td>{{ formatNumber(log.entityResEnd.resName) }}</td>
                                </tr>
                            {% endfor %}
                        </table>
                    {% endif %}

                    {{ log.message }}
                </td>
            </tr>
        </tbody>
    {% endfor %}
{% endblock %}

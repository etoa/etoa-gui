{% extends 'components/base_search.html.twig' %}

{% block data %}
    <tr>
        <th>ID</th>
        <th>Koordinaten</th>
        <th>Entitätstyp</th>
        <th>Subtyp</th>
        <th>Name</th>
        <th>Besitzer</th>
        <th>Aktion</th>
    </tr>
    {% for entity in search.entries %}
        <tr>
            <td>{{ entity.id }}</td>
            <td>{{ entity.coordinatesString() }}</td>
            <td class="entity-type-{{ entity.code }}">
                {{ entity.codeString() }}
                {% if entity.code == 'p' and entity.planet.mainPlanet %}
                    (Hauptplanet)
                {% elseif entity.code == 'w' and entity.wormhole.persistent %}
                    (persistent)
                {% endif %}

            </td>
            <td>
                {% if entity.code == 'p' %}
                    {{ entity.planet.planetType.name }}
                {% elseif entity.code == 's' %}
                    {{ entity.star.name }}
                {% endif %}
            </td>
            <td>{{ entity.displayName }}</td>
            <td>{{ entity.owner }}</td>
            <td>
                {% if entity.code != 'm' and entity.code != 'x' %}
                    <a href="{{ path('admin.universe.entity', {id: entity.id}) }}">Bearbeiten</a>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="999"><b>Keine Einträge gefunden!</b></td>
        </tr>
    {% endfor %}
{% endblock %}

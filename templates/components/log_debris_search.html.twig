{% extends 'components/base_search.html.twig' %}

{% block data %}
    <tr>
        <th style="width:140px;">Datum</th>
        <th>Admin</th>
        <th>User</th>
        <th>Titan</th>
        <th>Silizium</th>
        <th>PVC</th>
    </tr>
    {% for log in search.entries %}
        <tr>
            <td>{{ formatTimestamp(log.time) }}</td>
            <td>{{ log.admin?log.admin.nick:'?' }}</td>
            <td>{{ log.user?log.user.nick:'?' }}</td>
            <td>{{ log.metal }}</td>
            <td>{{ log.crystal }}</td>
            <td>{{ log.plastic }}</td>
        </tr>
    {% endfor %}
{% endblock %}

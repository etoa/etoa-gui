{% extends 'components/base_search.html.twig' %}

{% block data %}
    <tr>
        <th>Besitzer</th>
        <th>Aktion</th>
        <th>Status</th>
        <th>Start</th>
        <th>Ziel</th>
        <th>Startzeit</th>
        <th>Landezeit</th>
        <th>Aktion</th>
    </tr>
    {% for fleet in search.entries %}
        <tr>
            <td>{{ fleet.user.nick }}</td>
            <td>{{ fleet.action }}</td>
            <td>{{ fleet.status }}</td>
            <td>{{ fleet.entityFrom.toString }}</td>
            <td>{{ fleet.entityTo.toString }}</td>
            <td>{{ formatTimestamp(fleet.launchTime) }}</td>
            <td>{{ formatTimestamp(fleet.landTime) }}</td>
            <td>
                <a href="{{ path('admin.fleets.edit', {id: fleet.id}) }}">Bearbeiten</a>
                <a href="{{ path('admin.fleets.delete', {id: fleet.id}) }}">Löschen</a>
            </td>
        </tr>
    {% endfor %}
{% endblock %}

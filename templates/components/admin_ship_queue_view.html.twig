<tbody
    {{ attributes }}
    data-original-data="{}" {# Hack to prevent issue with symfony/ux #}
>
{% if this.item %}
    <tr>
        <td>{{ this.item.id }}</td>
        <td>{{ this.item.user?this.item.user.nick:'Niemand' }}</td>
        <td>{{ this.item.entity.entity.toString }}</td>
        <td>{{ this.item.ship.name }}</td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.count) }}</form>
            {% else %}
                {{ formatNumber(this.item.count) }}
            {% endif %}
        </td>
        <td>
            {{ formatTimespan(this.item.objectTime) }}
        </td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.startTime) }}</form>
            {% else %}
                {{ formatTimestamp(this.item.startTime) }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.endTime) }}</form>
            {% else %}
                {{ formatTimestamp(this.item.endTime) }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <a href="#ship-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="submit">Speichern</a>
                <a href="#ship-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="abortEdit">Abbrechen</a>
            {% else %}
                <a href="#ship-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="showEdit">Bearbeiten</a>
                <a href="#ship-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="finish">Fertig stellen</a>
                <a onclick="confirm('Sollen {{ this.item.count}} {{ this.item.ship.name }} von diesem Planeten gelöscht werden?')" href="#ship-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="delete">Löschen</a>
            {% endif %}
        </td>
    </tr>
{% endif %}
</tbody>

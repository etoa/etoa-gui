<span {{ attributes }}>
    {{ form_start(form) }}
        <twig:Table title="Accountlöschung">
            {% block table_content %}
                <tr {{ attributes }}>
                    <th>Account löschen</th>
                    {% if outerScope.confirmation %}
                        <td>
                            Soll dein Account wirklich zur Löschung vorgeschlagen werden?<br/><br/>
                            <b>Passwort eingeben:</b> {{ form_widget(form.password) }} {{ form_errors(form.password) }}
                        <td>
                            <button
                                    data-model="confirmation"
                                    data-value="false"
                                    data-action="live#update"
                                    type="button"
                            >
                                Abbrechen
                            </button>
                            {{ form_widget(form.confirmDelete) }}
                        </td>
                    {% else %}
                        <td>Hier kannst du deinen Account mitsamt aller Daten löschen. Dafür wird der Account automatisch in den Urlaubsmodus gesetzt und nach
                            {{ configValue('user_delete_days') }} Tagen gelöscht.
                        </td>
                        <td>
                            {% if outerScope.isUserDeleted %}
                               {{ form_widget(form.cancelDelete) }}
                            {% else %}
                                <button
                                        data-model="confirmation"
                                        data-value="true"
                                        data-action="live#update"
                                        type="button"
                                >
                                    Account löschen
                                </button>
                            {% endif %}
                        </td>
                    {% endif %}
                </tr>
            {% endblock %}
        </twig:Table>
    {{ form_end(form,{render_rest:false}) }}
</span>

<tbody
    {{ attributes }}
    data-original-data="{}" {# Hack to prevent issue with symfony/ux #}
>
{% if this.item %}
    <tr>
        <td>{{ this.item.id }}</td>
        <td>{{ this.item.user.nick }}</td>
        <td>{{ this.item.entity.toString }}</td>
        <td>{{ this.item.technology.name }}</td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.currentLevel) }}</form>
            {% else %}
                {{ formatNumber(this.item.currentLevel) }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.buildType) }}</form>
            {% else %}
                {{ this.item.buildType }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.startTime) }}</form>
            {% else %}
                {{ this.item.buildType ? formatTimestamp(this.item.startTime) : '-' }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <form data-model="on(change)|*" onkeydown="return event.key != 'Enter';">{{ form_widget(form.endTime) }}</form>
            {% else %}
                {{ this.item.buildType ? formatTimestamp(this.item.endTime) : '-' }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <a href="#technology-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="submit">Speichern</a>
                <a href="#technology-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="abortEdit">Abbrechen</a>
            {% else %}
                <a href="#technology-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="showEdit">Bearbeiten</a>
                <a onclick="confirm('Soll {{ this.item.technology.name }} {{ this.item.currentLevel}} von diesem Planeten gelöscht werden?')" href="#technology-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="delete">Löschen</a>
            {% endif %}
        </td>
    </tr>
{% endif %}
</tbody>

<div
    {{ attributes }}
>
    {{ form_start(form) }}
        {{ form_row(form.obj) }}
    {{ form_end(form) }}

    <div style="width:650px;text-align:center;;margin-left:10px;padding:10px;background:#fff;color:#000;border:1px solid #000">
        {% set object = this.object %}

        {% if this.requiredObjects|length > 0 %}
            <div class="techtreeItemContainer">
                {% for item in this.requiredObjects %}
                    {% set reqObject = item.building ?? item.tech %}
                    <div class="techtreeItem" style="background:url('{{ item.building?item.building.getImagePath('medium'):item.tech.getImagePath('medium') }}');">
                        <div class="techtreeItemLevel">Lvl <b>{{ item.level }}</b></div>
                        <a href="javascript:;" data-action="live#action" data-live-action-param="selectObject" data-live-object-id-param="{{ reqObject.id }}" data-live-object-type-param="{{ this.getObjectType(reqObject) }}" style="height:100%;display:block;"></a>
                        <div class="techtreeItemName">{{ item.building?item.building.name:item.tech.name }}</div>
                    </div>
                {% endfor %}
                <br style="clear:both;" />
            </div>

            <div style="margin:0 auto;">wird benötigt für</div>
        {% endif %}

        <div class="techtreeMainItem" style="background:url('{{ object.getImagePath('medium') }}');">
            <div class="techtreeItemName">{{ object.name }}</div>
        </div>

        {% if this.allowedObjects|length > 0 %}
            <div style="margin:10px auto;">ermöglicht</div>
            <div class="techtreeItemContainer">
                {% for item in this.allowedObjects %}
                    <div class="techtreeItem" style="background:url('{{ item.obj.getImagePath('medium') }}');">
                        <div class="techtreeItemLevel">Lvl <b>{{ item.level }}</b></div>
                        <a href="javascript:;" data-action="live#action" data-live-action-param="selectObject" data-live-object-id-param="{{ item.obj.id }}" data-live-object-type-param="{{ this.getObjectType(item.obj) }}" style="height:100%;display:block;"></a>
                        <div class="techtreeItemName">{{ item.obj.name }}</div>
                    </div>
                {% endfor %}
                <br style="clear:both;" />
            </div>
        {% endif %}
    </div>
</div>

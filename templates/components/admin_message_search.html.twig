{% extends 'components/base_search.html.twig' %}

    {% block labeling %}
        <p><b>Legende:</b> <span style="color:#0f0;">Ungelesen</span>, <span style="color:#f90;">Gelöscht</span>, <span style="font-style:italic;">Archiviert</span></p>
    {% endblock %}

{% block data %}
    <tr>
        <th>Datum</th>
        <th>Sender</th>
        <th>Empfänger</th>
        <th>Betreff</th>
        <th>Kategorie</th>
        <th>Aktion</th>
    </tr>
    {% for message in search.entries %}
        {{ component('admin_message_view', {
            message: message,
            userFrom: message.userFrom?message.userFrom.nick:('-'),
            userTo: message.userTo?message.userTo.nick:('-'),
            category: message.cat?message.cat.name:'',
            id: 'message-'~message.id
        }) }}
    {% endfor %}
{% endblock %}

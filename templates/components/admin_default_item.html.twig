<tbody
    {{ attributes }}
>
{% if this.item %}
    {% if this.isEdit %}
        {{ form_start(form, {'attr': {'onkeydown' :"return event.key != 'Enter';"}}) }}
    {% endif %}
    <tr>
        <td>{{ this.item.getObjectEntity.name }}</td>
        <td>
            {% if this.isEdit %}
                {{ form_row(form.count) }}
            {% else %}
                {{ this.item.count }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <a href="#item-{{ this.item.id }}" data-action="live#action" data-live-action-param="prevent|submit">Speichern</a>
                <a href="#item-{{ this.item.id }}" data-action="live#action" data-live-action-param="prevent|abortEdit">Speichern</a>
            {% else %}
                <a href="#item-{{ this.item.id }}" data-action="live#action" data-live-action-param="prevent|showEdit">Bearbeiten</a>
                <a href="#item-{{ this.item.id }}" data-action="live#action" data-live-action-param="prevent|delete">Löschen</a>
            {% endif %}
        </td>
    </tr>
    {% if this.isEdit %}
        {{ form_end(form) }}
    {% endif %}
{% endif %}
</tbody>

<tbody
    {{ attributes }}
>
{% if this.item %}
    {% if this.isEdit %}
        {{ form_start(form, {'attr': {'onkeydown' :"return event.key != 'Enter';"}}) }}
    {% endif %}
    <tr>
        <td>{{ this.objectName }}</td>
        <td>
            {% if this.isEdit %}
                {{ form_row(form.count) }}
            {% else %}
                {{ this.item.count }}
            {% endif %}
        </td>
        <td>
            {% if this.isEdit %}
                <a href="#item-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="submit">Speichern</a>
                <a href="#item-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="abortEdit">Abbrechen</a>
            {% else %}
                <a href="#item-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="showEdit">Bearbeiten</a>
                <a href="#item-{{ this.item.id }}" data-action="click->live#action:prevent" data-live-action-param="delete">Löschen</a>
            {% endif %}
        </td>
    </tr>
    {% if this.isEdit %}
        {{ form_end(form) }}
    {% endif %}
{% endif %}
</tbody>

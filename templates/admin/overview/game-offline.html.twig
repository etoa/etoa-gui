{% extends 'admin/layout/admin.html.twig' %}

{% block content %}
    <h1>Spiel offline nehmen</h1>

    {{ form_start(form) }}
    {% if isOffline %}
        <twig:alert type="warning">Das Spiel ist offline!</twig:alert>

        {{ form_row(form.offline_ips_allow) }}
        {{ form_row(form.offline_message) }}

        <div>
            {{ form_widget(form.save) }}
            {{ form_widget(form.online) }}
        </div>
    {% else %}
        <twig:alert type="success">Das Spiel ist online!</twig:alert>
        <div>
            {{ form_widget(form.offline) }}
        </div>
    {% endif %}
    {{ form_widget(form._token) }}
    {{ form_end(form,{render_rest:false}) }}
{% endblock %}

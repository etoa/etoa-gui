{% extends 'admin/layout/admin.html.twig' %}

{% block content %}
    <h1>Marktplatz</h1>
    <h2>Rohstoffe</h2>

    {% for offer in offers %}
        <table class="tb">
            <tr>
                <th>
                    Datum:
                </th>
                <td colspan="2">
                    {{ formatTimestamp(offer.date) }}
                </td>
                <th>
                    Spieler:
                </th>
                <td>
                    <a href="{{ path('admin.users.view', {id: offer.user.id}) }}">{{ offer.user.nick|default('Niemand') }}</a>
                </td>
                <td class="tbltitle">
                    <form method="post" action="{{ path('admin.market.resources.delete', {id: offer.id}) }}">
                        <input type="submit" onclick="return confirm('Soll dieses Angebot wirklich gelöscht werden?')"
                               value="Löschen"/>
                    </form>
                </td>
            </tr>
            {% for index, resourceName in resourceNames %}
                <tr>
                    {% if loop.first %}
                        <th rowspan="5">
                            Angebot:
                        </th>
                    {% endif %}

                    <td>{{ resourceName }}</td>
                    <td>
                        {{ formatNumber(offer.sellResources.get(index)) }}
                    </td>

                    {% if loop.first %}
                        <th rowspan="5">
                            Preis:
                        </th>
                    {% endif %}

                    <td>{{ resourceName }}</td>
                    <td>
                        {{ formatNumber(offer.buyResources.get(index)) }}
                    </td>
                </tr>
            {% endfor %}

        </table>
        <br/>
    {% else %}
        <p>Keine Angebote vorhanden!</p>
    {% endfor %}
{% endblock %}

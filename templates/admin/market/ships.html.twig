{% extends 'admin/layout/admin.html.twig' %}

{% block content %}
    <h1>Marktplatz</h1>
    <h2>Schiffe</h2>

    {% for offer in offers %}
        <table class="tb">
            <tr>
                <th>
                    Datum:
                </th>
                <td colspan="2">
                    {{ formatTimestamp(offer.date) }}
                </td>
                <th>
                    Spieler:
                </th>
                <td>
                    <a href="{{ path('admin.users.view', {id: offer.user.id}) }}">{{ offer.user.nick|default('Niemand') }}</a>
                </td>
                <td rowspan="4" class="tbltitle">
                    <form method="post" action="{{ path('admin.market.ships.delete', {id: offer.id}) }}">
                        <input type="submit" onclick="return confirm('Soll dieses Angebot wirklich gelöscht werden?')"
                               value="Löschen"/>
                    </form>
                </td>
            </tr>
            <tr>
                <th>
                    Schiffname:
                </th>
                <td colspan="2">
                    {{ offer.ship.name }}
                </td>
                <td>
                    Anzahl:
                    </td>
                <td>
                    {{ offer.count }}
                </td>
            </tr>
            <tr>
                {% for index, resourceName in resourceNames %}
                    <th>{{ resourceName }}</th>
                {% endfor %}
            </tr>
            <tr>
                {% for index, resourceName in resourceNames %}
                    <td>{{ formatNumber(offer.costs.get(index)) }}</td>
                {% endfor %}
            </tr>
        </table>
        <br/>
    {% else %}
        <p>Keine Angebote vorhanden!</p>
    {% endfor %}
{% endblock %}

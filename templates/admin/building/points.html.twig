{% extends 'admin/layout/admin.html.twig' %}

{% import 'admin/macros.html.twig' as macros %}

{% block content %}
    <h1>Gebäude</h1>

    <h3>Gebäudepunkt</h3>

    <p>Nach jeder Änderung an den Gebäuden müssen die Gebäudepunkte neu berechnet werden.</p>

    {{ form_start(form) }}
        {{ form_widget(form.calc) }}
    {{ form_end(form) }}

    {% for building in buildings %}
        <h2>{{ building.name }}</h2>
        <twig:Table>
        {% block table_content %}
            <tr>
                {% for item in building.points %}
                    <th>{{ item.level }}</th>
                    <td style="text-align: right" title="{{ item.points }}">{{ formatNumber(item.points) }}</td>
                    {% if loop.index is divisible by(4) and not loop.last %}
                        </tr>
                        <tr>
                    {% endif %}
                {% endfor %}
            </tr>
        {% endblock %}
        </twig:Table>
    {% endfor %}
{% endblock %}

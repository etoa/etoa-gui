{% extends 'admin/stats/base.html.twig' %}

{% block statsContent %}
    <h2>Diplomatiewertung</h2>

    <table class="table">
        <thead>
        <tr>
            <th>#</th>
            <th>Nick</th>
            <th>Rasse</th>
            <th>Allianz</th>
            <th>Bewertung</th>
        </tr>
        </thead>
        <tbody>
        {% for rating in ratings %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ rating.user.nick }}</td>
                <td>{{ rating.user.race.name }}</td>
                <td>{% if rating.user.alliance %}
                        {{ rating.user.alliance.tag }}
                    {% endif %}</td>
                <td>{{ formatNumber(rating.diplomacyRating) }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="99"><p>Keine Spieler gefunden</p></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}

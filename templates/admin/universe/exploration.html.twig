{% extends 'admin/layout/admin.html.twig' %}

{% block content %}
    <h1>Erkundung</h1>
    {{ form_start(form) }}
        <p>
            <b>Erkundungen anzeigen für:</b>
            {{ form_widget(form.users) }}
        </p>

        {% if form.users.vars.data %}
            <h3>Spieler '{{ form.users.vars.data.nick }}'</h3>
            <p>Erkundet: {{ discoveredPercent|round(2) }}%</p>
            <p>
                {{ form_widget(form.sx) }}:{{ form_widget(form.sy) }} /
                {{ form_widget(form.cx) }}:{{ form_widget(form.cy) }}
                Radius: {{ form_widget(form.radius) }}
                {{ form_widget(form.selected) }}
            </p>
            <p>
                {{ form_widget(form.reset) }}
                {{ form_widget(form.all) }}
            </p>
            <img src="{{ path('admin.images.map') }}?legend&user={{ form.users.vars.data.id }}" alt="Galaxiekarte" />
        {% else %}
            <p>Bitte Spieler wählen!</p>
        {% endif %}
    {{ form_end(form) }}
{% endblock %}

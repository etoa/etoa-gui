{% extends 'admin/layout/admin.html.twig' %}

{% block content %}
    <h2>Universum zurücksetzen</h2>
    {{ form_start(form) }}
        {% if planetWithUserCount %}
            <p>
                Es sind bereits Planeten im Besitz von Spielern. Du kannst das Universum zurücksetzen, jedoch werden
                sämtliche Gebäude, Schiffe, Forschungen etc von den Spielern gelöscht.
            </p>
        {% else %}
            <p>Es sind noch keine Planeten im Besitz von Spielern. Das Universum kann ohne Probleme gelöscht werden.</p>
        {% endif %}
        {{ form_widget(form.reset) }}
    {{ form_end(form) }}
{% endblock %}

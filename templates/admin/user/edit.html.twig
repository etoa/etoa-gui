{% set title="Spieler bearbeiten" %}

{% extends 'admin/layout/admin.html.twig' %}

{% block breadcrumbs %}
    {{ component('breadcrumbs', { items: [
        { label: 'Spielersuche', url: path('admin.users') },
        { label: form.vars.data.nick, url: path('admin.users.view', {id: form.vars.data.id}) },
        { label: 'Spieler bearbeiten', url: path('admin.users.edit', {id: form.vars.data.id}) },
    ]}) }}
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <input type="hidden" id="tabactive" name="tabactive" value=""/>
        <div class="tabs" id="user_edit_tabs">
            <ul>
                <li><a href="#tabs-2">Account</a></li>
                <li><a href="#tabs-3">Daten</a></li>
                <li><a href="#tabs-5">Profil</a></li>
                <li><a href="#tabs-6">Design</a></li>
                <li><a href="#tabs-7">Nachrichten</a></li>
            </ul>

            {# Account #}
            <div id="tabs-2">
                <table class="table">
                    <colgroup>
                        <col style="width: 200px">
                    </colgroup>
                    <tr>
                        <th><label for="user_nick">Nick</label></th>
                        <td>
                            {{ form_widget(form.nick) }}
                        </td>
                        <td>Eine Nickänderung ist grundsätzlich nicht erlaubt</td>
                    </tr>
                    <tr>
                        <th><label for="user_email">E-Mail</label></th>
                        <td>
                            {{ form_widget(form.email) }}
                        </td>
                        <td>Rundmails gehen an diese Adresse</td>
                    </tr>
                    <tr>
                        <th><label for="user_name">Name</label></th>
                        <td>
                            {{ form_widget(form.name) }}
                        </td>
                        <td>Bei Accountübergabe anpassen</td>
                    </tr>
                    <tr>
                        <th><label for="user_email_fix">E-Mail fix</label></th>
                        <td>
                            {{ form_widget(form.emailFix) }}
                        </td>
                        <td>Bei Accountübergabe anpassen</td>
                    </tr>
                    <tr>
                        <th><label for="dual_name">Name Dual</label></th>
                        <td>
                            {{ form_widget(form.dualName) }}
                        </td>
                        <td>Bei Dualänderung anpassen</td>
                    </tr>
                    <tr>
                        <th><label for="dual_email">E-Mail Dual</label></th>
                        <td>
                            {{ form_widget(form.dualEmail) }}
                        </td>
                        <td>Bei Dualänderung anpassen</td>
                    </tr>
                    <tr>
                        <th><label for="user_password">Passwort</label></th>
                        <td>
                            {{ form_widget(form.password) }}
                        </td>
                        <td>Leerlassen um altes Passwort beizubehalten</td>
                    </tr>
                    <tr>
                        <th>Geist</th>
                        <td>
                            {{ form_widget(form.ghost) }}
                        </td>
                        <td>Legt fest ob der Spieler in der Rangliste ausgeblendet wird</td>
                    </tr>
                    <tr>
                        <th>Chat-Admin</th>
                        <td>
                            {{ form_widget(form.chatAdmin) }}
                        </td>
                        <td>Der Spieler hat Adminrechte im Chat und einen silbernen Stern für Chatadmin,
                            einen grünen Stern für Leiter Team Community bzw. einen cyanfarbenen Stern für
                            Entwickler mit Adminrechten (Entwickler mit Adminrechten funktioniert nur, wenn unten
                            'Admin' auf 'Ja' gestellt wird).
                        </td>
                    </tr>
                    <tr>
                        <th>Admin</th>
                        <td>
                            {{ form_widget(form.admin) }}
                        </td>
                        <td>
                            Admin: Der Spieler wird in der Raumkarte als Game-Admin markiert.<br/>
                            Entwickler: Der Spieler bekommt einen nutzlosen roten Stern im Chat, keine Markierung
                        </td>
                    </tr>
                    <tr>
                        <th>NPC</th>
                        <td>
                            {{ form_widget(form.npc) }}
                        </td>
                        <td>Spieler wird als NPC markiert</td>
                    </tr>
                    <tr>
                        <th>Sperren</th>
                        <td>
                            {{ form_widget(form.blocked) }}
                            {% if isNoLongerBlocked %}<i><b>Diese Sperre ist abgelaufen!</b></i>{% endif %}
                            <table id="ban_options">
                                <tr>
                                    <td><label for="user_blocked_from">Von</label></td>
                                    <td>
                                        {{ form_widget(form.blockedFrom) }}
                                    </td>
                                </tr>
                                <tr>
                                    <td><label for="user_blocked_to">Bis</label></td>
                                    <td>
                                        {{ form_widget(form.blockedTo) }}
                                    </td>
                                </tr>
                                <tr>
                                    <td><label for="user_ban_admin_id">Admin</label></td>
                                    <td>
                                        {{ form_widget(form.banAdmin) }}
                                    </td>
                                </tr>
                                <tr>
                                    <td><label for="user_ban_reason">Grund</label></td>
                                    <td>
                                        {{ form_widget(form.banReason) }}
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td>Der Benutzer kann sich nicht einloggen und erscheint auf dem Pranger</td>
                    </tr>
                    <tr>
                        <th>U-Mod</th>
                        <td>
                            {{ form_widget(form.hmode) }}
                            {% if holidayModeExpired %}<i><b>Dieser Urlaubsmodus ist abgelaufen!</b></i>{% endif %}
                            <table id="umod_options">
                                <tr>
                                    <td><label for="user_hmode_from">Von</label></td>
                                    <td>
                                        {{ form_widget(form.hmodFrom) }}
                                    </td>
                                </tr>
                                <tr>
                                    <td><label for="user_hmode_to">Bis</label></td>
                                    <td>
                                        {{ form_widget(form.hmodTo) }}
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td>Der Benutzer kann nichts mehr bauen, wird aber auch nicht angegriffen</td>
                    </tr>
                </table>
            </div>

            {# Game-Daten #}
            <div id="tabs-3">
                <table class="table">
                    <colgroup>
                        <col style="width: 200px">
                    </colgroup>
                    <tr>
                        <th><label for="user_race_id">Rasse</label></th>
                        <td>
                            {{ form_widget(form.race) }}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="user_specialist_id">Spezialist</label></th>
                        <td>
                            {{ form_widget(form.specialist) }}
                            <span id="spt">
                                Bis: {{ form_widget(form.specialistTime) }}
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th><label for="user_alliance_id">Allianz</label></th>
                        <td>
                            {{ form_widget(form.alliance) }}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="spyship_count">Spionagesonden für Direktscan</label></th>
                        <td>
                            {{ form_widget(form.userProperties.spyShip) }}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="analyzeship_count">Analysatoren für Quickanalyse</label></th>
                        <td>
                            {{ form_widget(form.userProperties.analyzeShip) }}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="exploreship_count">Schiffe für Erkundung</label></th>
                        <td>
                            {{ form_widget(form.userProperties.exploreShip) }}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="user_alliace_shippoints">Verfügbare Allianzschiffteile</label>
                        </th>
                        <td>
                            {{ form_widget(form.allianceShipPoints) }}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="user_alliace_shippoints_used">Verbaute Allianzschiffteile</label></th>
                        <td>
                            {{ form_widget(form.allianceShipPointsUsed) }}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="user_multi_delets">Gelöschte Multis</label></th>
                        <td>
                            {{ form_widget(form.multiDelets) }}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="user_sitting_days">Sittertage</label></th>
                        <td>
                            {{ form_widget(form.sittingDays) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Hauptplanet geändert</th>
                        <td>
                            {{ form_widget(form.userChangedMainPlanet) }}
                        </td>
                    </tr>
                </table>
            </div>

            {# Profil #}
            <div id="tabs-5">
                <table class="table">
                    <colgroup>
                        <col style="width: 200px">
                    </colgroup>
                    <tr>
                        <th><label for="user_profile_text">Profil-Text</label></th>
                        <td>
                            {{ form_widget(form.profileText) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Profil-Bild</th>
                        <td>
                            {% if form.vars.data.profileImage %}
                                {% if form.vars.data.profileImageCheck %}
                                    <input type="checkbox" value="0" name="user_profile_img_check"
                                           id="user_profile_img_check">
                                    <label for="user_profile_img_check">Bild-Verifikation bestätigen</label><br/>
                                {% endif %}
                                <img src="{{ form.vars.data.userProperties.getProfileImageUrl }}" alt="Profil"/><br/>
                                {{ form_widget(form.imageDel) }}
                                <label for="form_imageDel">Bild löschen</label><br/>
                            {% else %}
                                <i>Keines</i>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="user_signature">Board-Signatur</label></th>
                        <td>
                            {{ form_widget(form.signature) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Avatarpfad</th>
                        <td>
                            {% if form.vars.data.avatar %}
                                <img src="{{ form.vars.data.avatar }}" alt="Profil"/><br/>
                                {{ form_widget(form.avatarDel) }}
                                <label for="form_avatarDel">Bild löschen</label><br/>
                            {% else %}
                                <i>Keines</i>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th><label for="user_profile_board_url">Öffentliches Foren-Profil</label></th>
                        <td>
                            {{ form_widget(form.profileBoardUrl) }}
                        </td>
                    </tr>
                </table>
            </div>

            {# Design #}
            <div id="tabs-6">
                <table class="table">
                    <colgroup>
                        <col style="width: 200px">
                    </colgroup>
                    <tr>
                        <th><label for="css_style">Design</label></th>
                        <td>
                            {{ form_widget(form.userProperties.cssStyle) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Planetenkreisgrösse</th>
                        <td>
                            {{ form_widget(form.userProperties.planetCircleWidth) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Schiff/Def Ansicht</th>
                        <td>
                            {{ form_widget(form.userProperties.itemShow) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Bildfilter</th>
                        <td>
                            {{ form_widget(form.userProperties.imageFilter) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Vertausche Buttons in Hafen-Schiffsauswahl</th>
                        <td>
                            {{ form_widget(form.userProperties.havenShipsButtons) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Werbung anzeigen</th>
                        <td>
                            {{ form_widget(form.userProperties.showAdds) }}
                        </td>
                    </tr>
                </table>
            </div>

            {# Messages #}
            <div id="tabs-7">
                <table class="table">
                    <colgroup>
                        <col style="width: 200px">
                    </colgroup>
                    <tr>
                        <th><label for="msgsignature">Nachrichten-Signatur</label></th>
                        <td>
                            {{ form_widget(form.userProperties.msgSignature) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Nachrichtenvorschau (Neue/Archiv)</th>
                        <td>
                            {{ form_widget(form.userProperties.msgPreview) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Nachrichtenvorschau (Erstellen)</th>
                        <td>
                            {{ form_widget(form.userProperties.msgCreationPreview) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Blinkendes Nachrichtensymbol</th>
                        <td>
                            {{ form_widget(form.userProperties.msgBlink) }}
                        </td>
                    </tr>
                    <tr>
                        <th>Text bei Antwort/Weiterleiten kopieren</th>
                        <td>
                            {{ form_widget(form.userProperties.msgCopy) }}
                    </tr>
                    <tr>
                        <th>Nachricht bei Transport-/Spionagerückkehr</th>
                        <td>
                            {{ form_widget(form.userProperties.fleetRtnMsg) }}
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <p>
            {{ form_widget(form.save) }} &nbsp;
        </p>
        <hr/>

        <p>
            {% if form.vars.data.deleted != 0 %}
                {{ form_widget(form.cancelDelete)}}
            {% else %}
                {{ form_widget(form.requestDelete)}}
            {% endif %}
            {{ form_widget(form.delete)}}
        </p>

        <script>
            $(function () {
                {% if form.vars.data.blockedFrom == 0 %}
                $('#ban_options').hide();
                {% endif %}

                {% if form.vars.data.hmodFrom == 0 %}
                $('#umod_options').hide();
                {% endif %}

                {% if not form.vars.data.specialist %}
                $('#spt').hide();
                {% endif %}
            });
        </script>
        {{ form_widget(form._token) }}
    {{ form_end(form,{render_rest:false}) }}
{% endblock %}


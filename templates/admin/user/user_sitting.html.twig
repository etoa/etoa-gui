{% set title="Sitting des Spielers " ~ user.nick %}

{% extends 'admin/layout/admin.html.twig' %}

{% block breadcrumbs %}
    {{ component('breadcrumbs', { items: [
        { label: 'Spielersuche', url: path('admin.users') },
        { label: user.nick, url: path('admin.users.view', {id: user.id}) },
        { label: 'Sitting', url: path('admin.users.user_sitting', {id: user.id}) },
    ]}) }}
{% endblock %}

{% block content %}

    {% if sittedEntries|length > 0 %}
        <h2>Wurde gesittet</h2>
        <table class="table">
            <thead>
            <tr>
                <th>Sitter</th>
                <th>Start</th>
                <th>Ende</th>
                <th>Abbrechen</th>
            </tr>
            </thead>
            <tbody>
            {% for sittedEntry in sittedEntries %}
                <tr>
                    <td>
                        <a href="{{ path('admin.users.view', { id: sittedEntry.sitter.id }) }}">{{ sittedEntry.sitter.nick }}</a>
                    </td>
                    <td>
                        {{ formatTimestamp(sittedEntry.dateFrom) }}
                    </td>
                    <td>
                        {{ formatTimestamp(sittedEntry.dateTo) }}
                    </td>
                    {% if sittedEntry.dateTo > date().timestamp %}
                        <td>
                            <form action="{{ path('admin.users.deleteSitting', {userSitting: sittedEntry.id }) }}"
                                  method="post" class="form-inline">
                                <button type="submit" class="button">Löschen</button>
                            </form>
                        </td>
                    {% else %}
                        <td></td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if sittingEntries|length > 0 %}
        <h2>Hat gesittet</h2>
        <table class="table">
            <thead>
            <tr>
                <th>Gesitteter User</th>
                <th>Start</th>
                <th>Ende</th>
            </tr>
            </thead>
            <tbody>
            {% for sittingEntry in sittingEntries %}
                <tr>
                    <td>
                        <a href="{{ path('admin.users.view', { id: sittingEntry.user.id }) }}">{{ sittingEntry.user.nick }}</a>
                    </td>
                    <td>
                        {{ formatTimestamp(sittingEntry.dateTo) }}
                    </td>
                    <td>
                        {{ formatTimestamp(sittingEntry.dateTo) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2>Sitting einrichten</h2>
    {{ form_start(form) }}
        <table>
            <tr>
                <td><label>Übrige Tage</label></td>
                <td>
                    {{ availableDays }}
                </td>
            </tr>
            <tr>
                <td><label for="sitter_nick">Sitter</label></td>
                <td>
                    {{ form_errors(form.sitter) }}
                    {{ form_widget(form.sitter) }}
                </td>
            </tr>
            <tr>
                <td><label for="sitter_password1">Passwort</label></td>
                <td>
                    {{ form_errors(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first) }}
                </td>
            </tr>
            <tr>
                <td><label for="sitter_password2">Passwort wiederholen</label></td>
                <td>
                    {{ form_widget(form.plainPassword.second) }}
                </td>
            </tr>
            <tr>
                <td><label for="sitting_time_from">Von</label></td>
                <td>
                    {{ form_widget(form.dateFrom) }}
                </td>
            </tr>
            <tr>
                <td><label for="sitting_time_to">Bis</label></td>
                <td>
                    {{ form_widget(form.dateTo) }}
                </td>
            </tr>
        </table>
        <br>
        {{ form_widget(form.submit) }}
    {{ form_end(form) }}
{% endblock %}

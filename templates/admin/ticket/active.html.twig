{% extends 'admin/ticket/base.html.twig' %}

{% block ticketContent %}
    <h3>Aktive Tickets</h3>

    {% if newTickets|length > 0 %}
        <h4>Neu</h4>
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Kategorie</th>
                <th>User</th>
                <th>Letzte Änderung</th>
            </tr>
            </thead>
            <tbody>
            {% for ticket in newTickets %}
                <div id="tt{{ ticket.id }}" style="display:none;">
                    <a href="{{ path('admin.users.view', {id: ticket.user.id}) }}">Daten anzeigen</a><br/>
                    <a href="{{ path('admin.messages.send', {userId: ticket.user.id}) }}">Nachricht senden</a><br/>
                </div>
                <tr>
                    <td>
                        <a href="{{ path('admin.ticket.details', {id: ticket.id}) }}">{{ ticket.idString }}</a>
                    </td>
                    <td>{{ ticket.statusName }}</td>
                    <td>{{ ticket.cat.name }}</td>
                    <td>
                        <a href="javascript:;" {{ cTT(ticket.user.nick, "tt" ~ ticket.id)|raw }}>{{ ticket.user.nick }}</a>
                    </td>
                    <td>{{ formatTimestamp(ticket.timestamp) }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if assignedTickets|length > 0 %}
        <h4>Zugeteilt</h4>
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Kategorie</th>
                <th>User</th>
                <th>Nachrichten</th>
                <th>Letzte Änderung</th>
            </tr>
            </thead>
            <tbody>
            {% for ticket in assignedTickets %}
                <tr>
                    <td>
                        <a href="{{ path('admin.ticket.edit', {id: ticket.id}) }}">{{ ticket.idString }}</a>
                    </td>
                    <td>{{ ticket.statusName }}: <b>{{ ticket.admin.nick }}</b></td>
                    <td>{{ ticket.cat.name }}</td>
                    <td>{{ ticket.user.nick }}</td>
                    <td>{{ ticket.ticketMessages|length }}</td>
                    <td>{{ formatTimestamp(ticket.timestamp) }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if newTickets|length == 0 and assignedTickets|length == 0 %}
        <p><i>Keine aktiven Tickets vorhanden!</i></p>
    {% endif %}
{% endblock %}

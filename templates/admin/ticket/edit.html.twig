{% extends 'admin/ticket/base.html.twig' %}

{% block ticketContent %}
    <h3>Ticket bearbeiten</h3>

    {{ form_start(form) }}
        <h3>Ticket {{ form.vars.data.getIdString }}</h3>
        <table>
            <tr>
                <th>Kategorie:</th>
                <td colspan="3">
                    {{ form_widget(form.cat) }}
                </td>
            </tr>
            <tr>
                <th>User:</th>
                <td>
                    <a href="javascript:;" {{ cTT(form.vars.data.user.nick, 'ttuser')|raw }}>{{ form.vars.data.user.nick }}</a>
                </td>
                <th>Zugeteilter Admin:</th>
                <td>
                    {{ form_widget(form.admin) }}
                </td>
            </tr>
            <tr>
                <th>Status:</th>
                <td>
                    {{ form_widget(form.status) }}
                </td>
                <th>Lösung:</th>
                <td>
                    {{ form_widget(form.solution) }}
                </td>
            </tr>
            <tr>
                <th>Admin-Kommentar:</th>
                <td colspan="3">
                    {{ form_widget(form.adminComment) }}
                </td>
            </tr>
        </table>
        <p>
            {{ form_widget(form.submit)}} &nbsp;
            <input type="button"  value="Abbrechen" onclick="document.location='{{ path('admin.ticket.details', {id: form.vars.data.id}) }}'" />
        </p>
    {{ form_end(form) }}
{% endblock %}

{% extends 'admin/ticket/base.html.twig' %}

{% block ticketContent %}
    <h3>Ticket erstellen</h3>
    {% if form.user.vars.choices|length > 0 %}
        {{ form_start(form) }}
            <table>
                <tr>
                    <th>User:</th>
                    <td>
                        {{ form_widget(form.user)}}
                    </td>
                </tr>
                <tr>
                    <th>Kategorie:</th>
                    <td>
                        {{ form_widget(form.cat) }}
                    </td>
                </tr>
                <tr>
                    <th>Problembeschreibung:</th>
                    <td>
                        {{ form_widget(form.ticketMessages) }}
                    </td>
                </tr>
            </table>
            <p>
                {{ form_widget(form.submit) }}
            </p>
        {{ form_end(form) }}
    {% endif %}
{% endblock %}

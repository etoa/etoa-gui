{% extends 'admin/ticket/base.html.twig' %}

{% block ticketContent %}
    <h3>Ticket Details</h3>

    <div id="ttuser" style="display:none;">
        <a href="{{ path('admin.users.view', {id: ticket.user.id}) }}">Daten anzeigen</a><br/>
        <a href="{{ path('admin.messages.send', {userId: ticket.user.id}) }}">Nachricht senden</a><br/>
    </div>

    {{ form_start(form) }}
        <h3>Ticket {{ ticket.getIdString() }}</h3>
        <table>
            <tr>
                <th style="width:150px">Kategorie:</th>
                <td>{{ ticket.cat.name }}</td>
            </tr>
            <tr>
                <th>Status:</th>
                <td>{{ ticket.getStatusName }}</td>
            </tr>
            <tr>
                <th>User:</th>
                <td><a href="javascript:;" {{ cTT(ticket.user.nick, "ttuser") }}>{{ ticket.user.nick }}</a></td>
            </tr>
            {% if ticket.admin %}
                <tr>
                    <th>Zugeteilter Admin:</th>
                    <td>{{ ticket.admin.nick }}</td>
                </tr>
            {% endif %}
            <tr>
                <th>Letzte Änderung:</th>
                <td>{{ formatTimestamp(ticket.timestamp) }}</td>
            </tr>
            <tr>
                <th>Admin-Kommentar:</th>
                <td colspan="3">
                    {{ form_widget(form.adminComment) }}
                    {{ form_widget(form.submitAdminComment) }}
                    (wird auch beim Senden einer neuen Nachricht gespeichert)
                </td>
            </tr>
        </table>

        <h3>Nachrichten</h3>
        <table>
            <tr>
                <th style="width:120px">Datum</th>
                <th style="width:130px">Autor</th>
                <th>Nachricht</th>
            </tr>
            {% for message in ticket.ticketMessages %}
                <tr>
                    <td>{{ formatTimestamp(message.timestamp) }}</td>
                    <td>{{ message.getAuthor }}</td>
                    <td>{{ BBCodeToHTML(message.message)|raw }}</td>
                </tr>
            {% endfor %}
        </table>

        {% if ticket.status == 'assigned' %}
            <h3>Neue Nachricht</h3>
            <table>
                <tr>
                    <th>Absender:</th>
                    <td>{{ app.user.username }} (Admin)</td>
                </tr>
                <tr>
                    <th>Nachricht:</th>
                    <td>
                        {{ form_widget(form.ticketMessages) }}
                    </td>
                </tr>
            </table>

            <p>
                {{ form_widget(form.submitNewPost) }}
                {{ form_widget(form.shouldClose) }}&nbsp;
                <label for="form_solution">Ticket abschliessen als</label>
                {{ form_widget(form.solution) }}
            </p>
        {% endif %}
    {{ form_widget(form._token) }}
    {{ form_end(form,{render_rest:false}) }}

    <input type="button" value="Zur Übersicht" onclick="document.location='{{ path('admin.overview') }}'"/>

    {% if ticket.status == 'new' %}
        <form action="{{ path('admin.ticket.assign', {id: ticket.id}) }}" method="POST">
            <input type="submit" name="submit_assign" value="Ticket mir zuweisen"/>
        </form>
    {% elseif ticket.status == 'closed' %}
        <form action="{{ path('admin.ticket.reopen', {id: ticket.id}) }}" method="POST">
            <input type="submit" name="submit_assign" value="Ticket wieder eröffnen"/>
        </form>
    {% elseif ticket.status == 'assigned' %}
        <form action="{{ path('admin.ticket.reopen', {id: ticket.id}) }}" method="POST">
            <input type="submit" name="submit_assign" value="Zuweisung widerrufen"/>
        </form>
    {% endif %}

    <input type="button" value="Ticketdetails bearbeiten"
           onclick="document.location='{{ path('admin.ticket.edit', {id: ticket.id}) }}'"/>
{% endblock %}

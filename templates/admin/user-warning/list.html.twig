{% extends 'admin/layout/admin.html.twig' %}

{% block content %}
    <h1>Spieler</h1>
    <h2>Verwarnungen</h2>

    {{ form(form) }}

    <h3>Bestehende Verwarnungen</h3>
    <table class="table">
        <thead>
        <tr>
            <th>Neuste Verwarnung</th>
            <th>Nick</th>
            <th>Verwarnungen</th>
        </tr>
        </thead>
        {% for userWarnings in warnings %}
            <tr>
                <td>{{ formatTimestamp(userWarnings.date) }}</td>
                <td>
                    <a href="{{ path('admin.users.view', {id: userWarnings.user.id}) }}">{{ userWarnings.user.nick }}</a>
                </td>
                <td><a href="#"
                       onclick="toggleBox('w{{ userWarnings.id }}')">{{ formatNumber(userWarnings|length) }}
                        Verwarnungen</a></td>
            </tr>
            <tr>
                <td colspan="99" id="w{{ userWarnings.id }}" style="display:none;">
                    <table>
                        <tr>
                            <th style="">Text</th>
                            <th>Datum</th>
                            <th>Verwarnt von</th>
                            <th>Optionen</th>
                        </tr>
                        <tr>
                            <td>{{ userWarnings.text|nl2br }}</td>
                            <td>{{ formatTimestamp(userWarnings.date) }}</td>
                            <td>{{ userWarnings.admin.nick }}</td>
                            <td>
                                <a href="{{ path('admin.users.warnings.edit', {id: userWarnings.id}) }}">Bearbeiten</a>
                                <a href="{{ path('admin.users.warnings.delete', {id: userWarnings.id}) }}"
                                   onclick="return confirm('Verwarnung löschen?')">Löschen</a>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="99"><i>Keine gefunden!</i></td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}

{% extends 'admin/layout/admin.html.twig' %}

{% import 'admin/macros.html.twig' as macros %}

{% block content %}
    <h1>Forschung</h1>

    <h3>Forschungspunkte</h3>

    <p>Nach jeder Änderung an den Forschungen müssen die Forschungspunkte neu berechnet werden.</p>

    {{ form_start(form) }}
        {{ form_widget(form.calc) }}
    {{ form_end(form) }}

    {% for technology in technologies %}
        <h2>{{ technology.name }}</h2>

        <twig:Table>
        {% block table_content %}
            <tr>
            {% for item in technology.points %}
                <th>{{ item.level }}</th>
                <td style="text-align: right" title="{{ item.points }}">{{ formatNumber(item.points) }}</td>

                {% if loop.index is divisible by(4) and not loop.last %}
                    </tr>
                    <tr>
                {% endif %}
            {% endfor %}
            </tr>
        {% endblock %}
        </twig:Table>
    {% endfor %}
{% endblock %}

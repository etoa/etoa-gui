{% set title="Rohstoffe der Allianz " ~ form.vars.data.toString %}

{% extends 'admin/layout/admin.html.twig' %}

{% block breadcrumbs %}
    {{ component('breadcrumbs', { items: [
        { label: 'Allianzsuche', url: path('admin.alliances') },
        { label: form.vars.data.toString, url: path('admin.alliances.view', {id: form.vars.data.id}) },
        { label: 'Rohstoffe', url: path('admin.alliances.resources', {id: form.vars.data.id}) },
    ]}) }}
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <table class="table">
            <tr>
                <th class="resmetalcolor">Titan</th>
                <td>
                    {{ form_widget(form.resMetal) }}
                    <br/>
                    +/-: {{ form_widget(form.addMetal) }}
                </td>
                <th class="rescrystalcolor">Silizium</th>
                <td>
                    {{ form_widget(form.resCrystal) }}
                    <br/>
                    +/-: {{ form_widget(form.addCrystal) }}
                </td>
            </tr>
            <tr>
                <th class="resplasticcolor">PVC</th>
                <td>
                    {{ form_widget(form.resPlastic) }}
                    <br/>
                    +/-: {{ form_widget(form.addPlastic) }}
                </td>
                <th class="resfuelcolor">Tritium</th>
                <td>
                    {{ form_widget(form.resFuel) }}
                    <br/>
                    +/-: {{ form_widget(form.addFuel) }}
                </td>
            </tr>
            <tr>
                <th class="resfoodcolor">Nahrung</th>
                <td>
                    {{ form_widget(form.resFood) }}
                    <br/>
                    +/-: {{ form_widget(form.addFood) }}
                </td>
            </tr>
        </table>

        <p>{{ form_widget(form.submit) }}</p>
    {{ form_end(form) }}
{% endblock %}

{% set title="Einzahlungen für die Allianz " ~ alliance.toString %}

{% extends 'admin/layout/admin.html.twig' %}

{% block breadcrumbs %}
    {{ component('breadcrumbs', { items: [
        { label: 'Allianzsuche', url: path('admin.alliances') },
        { label: alliance.toString, url: path('admin.alliances.view', {id: alliance.id}) },
        { label: 'Einzahlungen', url: path('admin.alliances.deposit', {id: alliance.id}) },
    ]}) }}
{% endblock %}

{% block content %}
    {{ component('admin_alliance_deposit_search', {
        form: form,
        alliance: alliance
    }) }}
{% endblock %}

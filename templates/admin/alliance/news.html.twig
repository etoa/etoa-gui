{% set title="Allianznews (Rathaus)" %}

{% extends 'admin/layout/admin.html.twig' %}

{% block content %}
    
    {{ form(cleanupForm) }}

    <hr/>

    {{ form(defaultBanForm) }}

    <table class="table">
        <thead>
        <tr>
            <th>Datum</th>
            <th>Absender</th>
            <th>Empfänger</th>
            <th>Titel / Text</th>
            <th>Aktion</th>
        </tr>
        </thead>
        <tbody>
        {% for news in newsEntries %}
            <tr>
                <td rowspan="2">{{ formatTimestamp(news.date) }}</td>
                <td style="border-bottom:1px dotted #999;">
                    <b>
                        {% if news.author.alliance %}
                            [{{ news.author.alliance.tag }}] {{ news.author.alliance.name }}
                        {% else %}
                            <span style="color:#999;">Allianz existiert nicht!</span>
                        {% endif %}
                    </b>
                </td>
                <td style="border-bottom:none;">
                    <b>
                        {% if news.toAlliance %}
                            [{{ news.toAlliance.tag }}] {{ news.toAlliance.name }}
                        {% else %}
                            <span style="color:#999;">Allianz existiert nicht!</span>
                        {% endif %}
                    </b>
                </td>
                <td style="border-bottom:1px dotted #999;">
                    <b>{{ news.title }}</b>
                </td>
                <td rowspan="2">
                    <a href="{{ path('admin.alliances.news.edit', {id: news.id}) }}"><img src="{{ asset('build/images/edit.gif') }}"
                                                                                          alt="Edit"
                                                                                          style="border:none;"/></a>
                    <form class="inline-block" method="post" onsubmit="if (confirm('Beitrag löschen?'));"
                          action="{{ path('admin.alliances.news.delete', {id: news.id}) }}">
                        <input type="hidden" name="newsId" value="{{ news.id }}">
                        <input type="image" src="{{ asset('build/images/delete.gif') }}" alt="Beitrag löschen" style="border:none;"/>
                    </form>
                    {% if news.author %}
                        <form class="inline-block" method="post" onsubmit="if (confirm('Benutzer sperren?'));"
                              action="{{ path('admin.alliances.news.ban', {id: news.id}) }}">
                            <input type="hidden" name="newsId" value="{{ news.id }}">
                            <input type="image" src="{{ asset('build/images/lock.png') }}" alt="Benutzer sperren" style="border:none;"/>
                        </form>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td style="border-top:none;">
                    {% if news.author %}
                        {{ news.author.nick }}
                    {% else %}
                        <span style="color:#999;">Spieler existiert nicht!</span>
                    {% endif %}
                </td>
                <td style="border-top:none;"></td>
                <td style="border-top:none;">{{ news.text }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Keine Einträge vorhanden.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}

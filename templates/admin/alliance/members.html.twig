{% set title="Mitglieder der Allianz " ~ formMembers.vars.data.toString %}

{% extends 'admin/layout/admin.html.twig' %}

{% block breadcrumbs %}
    {{ component('breadcrumbs', { items: [
        { label: 'Allianzsuche', url: path('admin.alliances') },
        { label: formMembers.vars.data.toString, url: path('admin.alliances.view', {id: formMembers.vars.data.id}) },
        { label: 'Mitglieder', url: path('admin.alliances.members', {id: formMembers.vars.data.id}) },
    ]}) }}
{% endblock %}

{% block content %}

    {{ form_start(formMembers) }}
        <h2>Mitglieder</h2>

        <table class="table">
            <tr>
                <th>Name</th>
                <th>Punkte</th>
                <th>Rang</th>
                <th>Mitgliedschaft beenden</th>
            </tr>
            {% for member in formMembers.members %}
                <tr>
                    <td id="uifo{{ member.vars.data.id }}" style="display:none;">
                        <a href="{{ path('admin.users.view', {id: member.vars.data.id}) }}">Daten</a>
                        <br/>
                        <a href="{{ path('admin.messages.send', {userId: member.vars.data.id}) }}">Nachricht
                            senden</a>
                    </td>
                    <td>
                        <a href="{{ path('admin.users.view', {id: member.vars.data.id}) }}" {{ cTT(member.vars.data.nick, 'uifo', member.vars.data.id) }}>{{ member.vars.data.nick }}</a>
                    </td>
                    <td>{{ formatNumber(member.vars.data.points) }} Punkte</td>
                    <td>
                        {{ form_widget(member.allianceRank) }}
                    </td>
                    <td>
                        {{ form_widget(member.kick) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9999"><b>KEINE MITGLIEDER!</b></td>
                </tr>
            {% endfor %}
        </table>
        {{ form_widget(formMembers.submit) }}
    {{ form_end(formMembers) }}
    {{ form_start(formRanks) }}
        <h2>Ränge</h2>

        <table class="table">
            <tr>
                <th>Name</th>
                <th>Level</th>
                <th>Löschen</th>
            </tr>
            {% for rank in formRanks.ranks %}
                <tr>
                    <td>
                        {{ form_widget(rank.name) }}
                    </td>
                    <td>
                        {{ form_widget(rank.level) }}
                    </td>
                    <td>
                        {{ form_widget(rank.delete) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9999"><em>Keine Ränge vorhanden.</em></td>
                </tr>
            {% endfor %}
        </table>

        <p>{{ form_widget(formRanks.submit) }}</p>
    {{ form_end(formRanks) }}
{% endblock %}

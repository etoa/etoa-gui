{% set title="Diplomatie der Allianz " ~ alliance.toString %}

{% extends 'admin/layout/admin.html.twig' %}

{% block breadcrumbs %}
    {{ component('breadcrumbs', { items: [
        { label: 'Allianzsuche', url: path('admin.alliances') },
        { label: alliance.toString, url: path('admin.alliances.view', {id: alliance.id}) },
        { label: 'Diplomatie', url: path('admin.alliances.diplomacy', {id: alliance.id}) },
    ]}) }}
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <table class="table">
            <thead>
            <tr>
                <th>Allianz</th>
                <th>Bezeichnung</th>
                <th>Status</th>
                <th>Datum</th>
                <th>Löschen</th>
            </tr>
            </thead>
            <tbody>
            {% for diplomacy in form.diplomacy %}
                <tr>
                    <td>
                        {% if diplomacy.vars.data.alliance1 == alliance %}
                            <a href="{{ path('admin.alliances.edit', {id: diplomacy.vars.data.alliance2.id}) }}">{{ diplomacy.vars.data.alliance2.toString }}</a>
                        {% else %}
                            <a href="{{ path('admin.alliances.edit', {id: diplomacy.vars.data.alliance1.id}) }}">{{ diplomacy.vars.data.alliance1.toString }}</a>
                        {% endif %}
                    </td>
                    <td>
                        {{ form_widget(diplomacy.name) }}
                    </td>
                    <td>
                        {{ form_widget(diplomacy.level) }}
                    </td>
                    <td>
                        {{ formatTimestamp(diplomacy.vars.data.date) }}
                    </td>
                    <td>
                        {{ form_widget(diplomacy.delete) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9999"><em>Keine Bündnisse/Kriege vorhanden.</em></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if form.diplomacy|length > 0 %}
            <p>
                {{ form_widget(form.submit) }}
            </p>
            {{ form_widget(form._token) }}
        {% endif %}
    {{ form_end(form,{render_rest:false}) }}
{% endblock %}

{% extends 'layout/base.html.twig' %}
{% import 'macros.html.twig' as macros %}
{#
-----------------------------------------------------------------------------------------------------------------------------------
//--Beschreibung       :         Re:Discovery-Menuedesign Version
//---------------------------------------------------------------------------------------------------------------------------------
#}
{% block layoutContent %}
<div id="app" class="mouse">
  {# --------------------------------- Mobile Reload Hinweis --------------------------------- #}
  <div class="mobile-reloader"></div>

  {# ----------------------------------- Obere Menueleiste ----------------------------------- #}
  <div class="navigation-top">
    <a href="{{ path('game.stats.total') }}" title="Statistiken (Kürzel: [s])">Statistiken</a>
    <a href="{{ etoaUrl('forum') }}" target="_blank" title="Forum">Forum</a>
    <a href=""  id="open-chat" title="Chat">Chat</a>
    <a href="javascript:"
       onclick="{{ onClick('teamspeak') }}" title="Discord">Discord</a>
    <a href="{{ path('game.config.general') }}" title="Einstellungen">Einstellungen</a>
    <a href="javascript:"
       onclick="{{ onClick('rules') }}" title="Regeln">Regeln</a>
    <a href="javascript:"
       onclick="{{ onClick('helpcenter') }}" title="HelpCenter">HelpCenter</a>
    <a href="{{ path('game.logout') }}">Eject</a>
  </div>

  {# ----------------------------------- Linke Menueleiste ----------------------------------- #}
  <div class="navigation-main">
    <!-- Top Section -->
    <section id="nav-top">
      <a id="navigate-overview" class="button-round-blue" href="{{ path('game.overview') }}" title="Zur Übersicht (Kürzel: [Leertaste])"></a>
      <span id="server-time-label">Serverzeit</span>
      <span id="server-time" class="servertime">{{ serverTime() }}</span>
      <span id="current-planet-name" class="current-planet">{{ currentPlanetName }}</span>
      <a id="navigate-help" class="button-round-blue"
        {% if helpBox %}
        href="javascript:" onclick="window.open('popup.php?page=help','help','status=no,width=800,height=600,scrollbars=yes,resizable=yes');"
      {% else %}
        href="?page=help"
        {% endif %}></a>
      <div id="planet-dropdown" class="planet-dropdown"
           onmouseleave="this.setAttribute('data-expanded', 'false');return true;">
        <div class="click-mask" onclick="this.parentNode.setAttribute('data-expanded', 'false');return true;"></div>
        {% for planet in planetList %}
          <a href="{{ planet.url|raw }}"
             class="button-blue {% if planet.current %}active{% endif %}">{{ planet.label }}</a>
        {% endfor %}
      </div>
      <a id="toggle-planet-dropdown" class="button-triangular" href="javascript:"></a>
      <a id="change-planet-previous" class="button-triangular" href="javascript:" title="Zum vorherigen Planet (Kürzel: [1])"
         onclick="document.location='?change_entity={{ prevPlanetId }}'"></a>
      <a id="change-planet-hext" class="button-triangular" href="javascript:" title="Zum nächsten Planet (Kürzel: [2])"
         onclick="document.location='?change_entity={{ nextPlanetId }}'"></a>
    </section>

    <!-- Middle Section -->
    <section id="nav-common">
      <span class="section-label">Allgemeines</span>
      <a class="button-blue" href="{{ path('game.alliance') }}" title="Allianz (Kürzel: [a])">Allianz</a>
      <a class="button-blue" href="{{ path('game.townhall') }}" title="Rathaus">Rathaus</a>
      <a class="button-blue" href="{{ path('game.sector') }}" title="Raumkarte (Kürzel: [k])">Raumkarte</a>
      <a class="button-blue" href="{{ path('game.fleets') }}" title="Flotten (Kürzel: [l])">Flotten</a>
      <a class="button-blue" href="{{ path('game.bookmarks.target') }}" title="Favoriten (Kürzel: [v])">Favoriten</a>
    </section>

    <section id="nav-planet">
      <span class="section-label">Planet</span>
      <a class="button-blue" href="{{ path('game.planetoverview.overview') }}" title="Informationen">Informationen</a>
      <a class="button-blue" href="{{ path('game.economy',{id:currentPlanetId}) }}" title="Wirtschaft (Kürzel: [p])">Wirtschaft</a>
      <a class="button-blue" href="{{ path('game.population',{id:currentPlanetId}) }}" title="Bevölkerung (Kürzel: [B])">Bevölkerung</a>
      <a class="button-blue" href="{{ path('game.techtree.general') }}" title="Technikbaum">Technikbaum</a>
      <a class="button-blue" href="{{ path('game.haven.show') }}" title="Raumschiffhafen (Kürzel: [h])">Raumschiffhafen</a>
      <a class="button-blue" href="{{ path('game.market.home') }}" title="Marktplatz (Kürzel: [m])">Marktplatz</a>
      <a class="button-blue" href="{{ path('game.crypto') }}" title="Kryptocenter">Kryptocenter</a>
      <a class="button-blue" href="{{ path('game.bunker.res') }}" title="Bunker">Bunker</a>
    </section>

    <section id="nav-production">
      <span class="section-label">Produktion</span>
      <a class="button-blue" href="{{ path('game.buildings') }}" title="Bauhof (Kürzel: [g])">Bauhof</a>
      <a class="button-blue" href="{{ path('game.research') }}" title="Forschung (Kürzel: [f])">Forschung</a>
      <a class="button-blue" href="{{ path('game.shipyard') }}" title="Raumschiffswerft (Kürzel: [w])">Raumschiffswerft</a>
      <a class="button-blue" href="{{ path('game.defense') }}" title="Verteidigungsanlagen (Kürzel: [d])">Verteidigungsanlagen</a>
      <a class="button-blue" href="{{ path('game.recycle') }}" title="Recycling">Recycling</a>
      <a class="button-blue" href="{{ path('game.missiles') }}" title="Raketensilo (Kürzel: [r])">Raketensilo</a>
    </section>

    <section id="nav-other">
      <span class="section-label">Sonstiges</span>
      <a class="button-blue {% if buddys %}text-glow-green{% endif %}" href="{{ path('game.buddylist.overview') }}">Buddyliste</a>
    </section>

    <section id="nav-bottom">
      <!-- Bottom Section -->
      <a id="navigate-messages" class="button-round-blue {% if messages > 0 %}unread{% endif %}" title="Nachrichten (Kürzel: [n])"
         href="{{ path('game.messages.inbox') }}"></a>
      <a id="navigate-reports" class="button-round-blue {% if newreports > 0 %}unread{% endif %}" title="Berichte (Kürzel: [b])"
         href="{{ path('game.reports.all') }}"></a>
      <a id="navigate-fleets-2" class="button-attack {% if fleetAttack > 0 %}attack-alert{% endif %}" title="Flotten (Kürzel: [l])"
         href="{{ path('game.fleets') }}">Angriff</a>
      <a id="navigate-notes" class="button-round-blue" title="Notizen"
        {% if noteBox is defined %}
        href="javascript:" onclick="window.open('{{ path('game.notepad.list',{popup:1}) }}');"
      {% else %}
        href="{{ path('game.notepad.list') }}"
        {% endif %}></a>
    </section>
  </div>

  {# ----------------------------------- Mobile Menueleiste ----------------------------------- #}
  <div class="navigation-mobile">
    <!-- Hauptnavigation Mobile -->
    <section id="mobile-shortcuts">
      <!-- Hauptmenue toggle -->
      <a id="main-menu-toggle" class="button-round-blue" href="javascript:"></a>
      <!-- Serverzeit -->
      <span id="server-time-mobile" class="servertime">{{ serverTime() }}</span>
      <!-- Flottenalarm -->
      <a id="navigate-fleets-mobile" class="button-attack {% if fleetAttack > 0 %}attack-alert{% endif %}"
         href="{{ path('game.fleets') }}">Angriff</a>
      <!-- Mobilemenue toggle -->
      <a id="top-menu-toggle" class="button-round-blue" href="javascript:"></a>
    </section>
    <!-- Schnellzugriff für Planetenwahl -->
    <section id="mobile-planet-selection">
      <span
        id="current-planet-name-mobile"
        class="current-planet"
      >{{ currentPlanetName }}</span>
      <div id="planet-dropdown-mobile" class="planet-dropdown">
        {% for planet in planetList %}
          <a href="{{ planet.url|raw }}"
             class="button-blue {% if planet.current %}active{% endif %}">{{ planet.label }}</a>
        {% endfor %}
      </div>
      <a id="change-planet-previous-mobile" class="button-triangular" href="javascript:"
         onclick="document.location='?change_entity={{ prevPlanetId }}'"></a>
      <a id="change-planet-next-mobile" class="button-triangular" href="javascript:"
         onclick="document.location='?change_entity={{ nextPlanetId }}'"></a>
    </section>
  </div>

  {# -----------------------------------  Game-Area ----------------------------------- #}

  {% if adds is defined %}
    <div id="adds">
      {{ addBanner }}
    </div>
  {% endif %}

  {% include 'layout/chunks/tutorial.html.twig' %}
  {% include 'layout/chunks/quests.html.twig' %}

  <div id="game-area">
    <div id="contentwrap">
      <twig:BackendStatusMessage/>

      {% for type, messages in app.flashes|default([]) %}
        {% for message in messages %}
          {{ macros.message('',message,type) }}
        {% endfor %}
      {% endfor %}

      {{ content|default('')|raw }}
      {% block content %}
      {% endblock %}
    </div>
  </div>
  {{ component('chat_view',{id:'ingame-chat'}) }}

</div>
{% endblock %}

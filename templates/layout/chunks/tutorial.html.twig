{# The box is hidden until a tutorial is opened and is always rendered, because the
   "Anzeigen" button in the settings needs it even when no tutorial is currently due. #}
    <div id="tutorialContainer" style="display:none;" data-tutorial="0">
        <div class="tutorialBox">
            <div class="tutorialTitle">Tutorial: <span class="tutorialTitleContent"></span>
                <span style="float:right;">
                    <input type="button" value="Min" class="tutorialMinimize" title="Minimieren" />
                    <input type="button" value="X" class="tutorialClose" title="Schliessen" />
                </span><br style="clear:both;">
            </div>
            <div class="tutorialContent">...</div>
            <div class="tutorialFooter">
                <input type="button" value="Zurück" class="tutorialPrev" style="display:none;" />
                <span style="float:right;">
                    <input type="button" value="Weiter" class="tutorialNext" style="display:none;" />
                    <input type="button" value="Schliessen" class="tutorialFinish" style="display:none;" />
                </span><br style="clear:both;">
            </div>
        </div>
        <div class="tutorialBoxReduced">
            <input type="button" value="Tutorial" class="tutorialRestore" />
        </div>
    </div>
    {# tutorial.js needs $.cookie and is only used here, so both are loaded with the box #}
    <script type="text/javascript" src="{{ asset('build/js/jquery.cookie.js') }}"></script>
    <script type="text/javascript" src="{{ asset('build/js/tutorial.js') }}"></script>
{% if tutorial_id|default(0) > 0 %}
    <script>
        $(function(){
            showTutorialText({{ tutorial_id }});
        });
    </script>
{% endif %}
